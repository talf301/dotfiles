             or Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rexbar" / "ai-usage.json")
# A pane's command may start without the login shell's PATH, so every tool is
# found on a PATH built here, and subprocesses get the same PATH.
TOOL_DIRS = [str(Path.home() / ".local/bin"), str(Path.home() / ".cargo/bin"), "/opt/homebrew/bin",
             "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
PATH = os.pathsep.join(d for d in dict.fromkeys(TOOL_DIRS + os.environ.get("PATH", "").split(os.pathsep)) if d)


def tool(name, env, default):
    return os.environ.get(env) or shutil.which(name, path=PATH) or default


AI_USAGE = tool("ai-usage", "REXBAR_AI_USAGE", str(Path.home() / ".cargo/bin/ai-usage"))
REXBOARD = tool("rexboard", "REXBAR_REXBOARD", "/opt/homebrew/bin/rexboard")
REX = tool("rex", "REXBAR_REX", "/opt/homebrew/bin/rex")
