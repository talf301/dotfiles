BOARD_TTL = 4              # seconds between rexboard runs
LOG_MAX = 500              # events kept in objectives-log.json
STATUSES = ("todo", "doing", "done", "blocked")


def fail(message, code=1):
    print(f"rexbar: {message}", file=sys.stderr)
    sys.exit(code)


ERRORS = []  # (time, message) of failed source runs, newest last


def note_error(message):
    ERRORS.append((time.time(), message))
    del ERRORS[:-20]


def run(args, timeout=20):
    env = {**os.environ, "PATH": PATH}
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                              stdin=subprocess.DEVNULL, env=env)
    except FileNotFoundError:
        return subprocess.CompletedProcess(args, 127, "", f"{args[0]}: not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", f"{args[0]}: timed out after {timeout}s")
    except OSError as e:
        return subprocess.CompletedProcess(args, 126, "", str(e))


# ---- state files --------------------------------------------------------------

SESSION_ID = re.compile(r"^[0-9a-fA-F-]{8,64}$")


def session_dir(session):
    """The session's state dir, or None if the id is not a plain Rex session id."""
    sid = session[len("session:"):] if session.startswith("session:") else session
    if not SESSION_ID.match(sid):
        return None
    root = STATE.resolve()
    directory = (root / sid).resolve()
    if directory.parent != root or directory.name != sid:
        return None
    return directory


def read_json(path, default):
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default
    return data if isinstance(data, type(default)) else default


def write_json(path, data):
    """Atomic write through a uniquely named temp file in the same directory."""
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class Lock:
    """flock on a file; opened for append so it is never truncated."""

    def __init__(self, path):
        self.path = path

    def __enter__(self):
        self.f = open(self.path, "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def mtime(path):
    try:
        return Path(path).stat().st_mtime_ns
    except OSError:
        return None


# ---- objectives -----------------------------------------------------------------

OBJ_LINE = re.compile(r"^(?P<indent>[ \t]*)[-*+][ \t]+(?:\[[ xX]\][ \t]+)?(?P<status>[A-Za-z]+)[ \t]*:[ \t]*(?P<text>.*)$")


def parse_objectives(text):
    """Goals as dicts {status, text, depth, path}, in file order.

    Only `- status: text` lines with a known status count. Depth comes from the
    indent (a tab is 4 spaces); `path` joins the parents' texts so a goal is
    keyed by where it sits as well as what it says.
    """
    items, stack = [], []  # stack: (indent, text)
    for line in text.splitlines():
        m = OBJ_LINE.match(line)
        if not m:
            continue
        status = m.group("status").lower()
        if status not in STATUSES:
            continue
        indent = len(m.group("indent").replace("\t", "    "))
        body = m.group("text").strip()
        while stack and stack[-1][0] >= indent:
            stack.pop()
        path = " / ".join([t for _, t in stack] + [body])
        items.append({"status": status, "text": body, "depth": len(stack), "path": path})
        stack.append((indent, body))
    return items


def summarize_objectives(items):
    doing = [i for i in items if i["status"] == "doing"]
    deepest = max((i["depth"] for i in doing), default=-1)
    current = [i for i in doing if i["depth"] == deepest]
    return {
        "total": len(items),
        "done": sum(i["status"] == "done" for i in items),
        "blocked": sum(i["status"] == "blocked" for i in items),
        "doing": current[0]["text"] if current else None,
        "doing_more": max(0, len(current) - 1),
        "doing_path": current[0]["path"] if current else None,
    }


def clean(text):
    """One display line: no markdown backticks, no control characters."""
    text = (text or "").replace("`", "")
    return "".join(" " if unicodedata.category(c)[0] == "C" else c for c in text).strip()


# ---- the bar's own log ------------------------------------------------------------

def update_log(directory, items, session, now=None):
    """Append goal-status and review changes to bar/objectives-log.json.

    The first time a source is seen it is only recorded as the baseline. items
    is None when objectives.md could not be read, so a missing file never reads
    as every goal removed. Returns the log.
    """
    now = int(now if now is not None else time.time())
    bar = directory / "bar"
    try:
        bar.mkdir(exist_ok=True, mode=0o700)
    except OSError:
        return {"events": []}
    path = bar / "objectives-log.json"
    with Lock(bar / "lock"):
        log = read_json(path, {})
        events = log.get("events") if isinstance(log.get("events"), list) else []
        changed = False
        if items is not None:
            snap = {i["path"]: i["status"] for i in items}
            old = log.get("objectives")
            if isinstance(old, dict):
                for key, status in snap.items():
                    if old.get(key) != status:
                        text = key.rsplit(" / ", 1)[-1]
                        events.append({"t": now, "kind": "objective", "status": status, "text": text,
                                       "from": old.get(key)})
                        changed = True
            if old != snap:
                log["objectives"] = snap
                changed = True
        reviews = session.get("last_reviewed") if isinstance(session, dict) else None
        if isinstance(reviews, dict):
            reviews = {str(k): str(v) for k, v in reviews.items()}
            old = log.get("reviews")
            if isinstance(old, dict):
                for top, sha in reviews.items():
                    if old.get(top) != sha:
                        events.append({"t": now, "kind": "review", "text": f"{Path(top).name} at {sha[:8]}"})
                        changed = True
            if old != reviews:
                log["reviews"] = reviews
                changed = True
        if changed:
            log["events"] = events[-LOG_MAX:]
            log["version"] = 1
            write_json(path, log)
        log.setdefault("events", events)
        return log


def collect_events(session, history, log):
    """All history events, oldest first: {t, kind, text, status?}."""
    events = []
    for item in history.get("items", []) if isinstance(history, dict) else []:
        if isinstance(item, dict) and isinstance(item.get("time"), (int, float)):
            events.append({"t": item["time"], "kind": "picture", "text": str(item.get("title") or "picture")})
    for e in log.get("events", []) if isinstance(log, dict) else []:
        if isinstance(e, dict) and isinstance(e.get("t"), (int, float)) and e.get("kind") in ("objective", "review"):
            events.append(e)
    if isinstance(session, dict):
        filing = session.get("filing") if isinstance(session.get("filing"), dict) else {}
        promoted = session.get("promoted_at") or filing.get("at")
        if isinstance(promoted, (int, float)):
            events.append({"t": promoted, "kind": "promote",
                           "text": f"promoted to {session.get('ticket') or filing.get('ticket') or 'ticket'}"})
        if isinstance(session.get("landed_at"), (int, float)):
            events.append({"t": session["landed_at"], "kind": "land", "text": "landed"})
    events.sort(key=lambda e: e["t"])
    return events


# ---- external sources ---------------------------------------------------------------

def board_rows(session_id, rows):
    if not isinstance(rows, list):
        return []
    return [r for r in rows if isinstance(r, dict) and r.get("session_id") == session_id]


def agent_summary(rows, main_block=None, window=None):
    """Counts by state and the main agent's usage, from rexboard rows of one session."""
    out = {"working": 0, "waiting": 0, "idle": 0, "sub": 0, "main": None}
    for r in rows:
        group, state = r.get("group"), r.get("state")
        if r.get("stale"):
            out["idle"] += 1
        elif group == "working" or (group is None and state == "working"):
            out["working"] += 1
        elif group == "needs_you" or state in ("question", "permission"):
            out["waiting"] += 1
        else:
            out["idle"] += 1
        children = r.get("children")
        if isinstance(children, dict):
            out["sub"] += sum(v for k, v in children.items() if k == "working" and isinstance(v, int))
    out["panes"] = agent_panes(rows, window)
    with_usage = [r for r in rows if isinstance(r.get("usage"), dict)]
    pick = [r for r in with_usage if r.get("block_id") == main_block] or \
           [r for r in with_usage if window and r.get("window_id") == window] or with_usage
    if pick:
        pick.sort(key=lambda r: str(r.get("updated_at") or ""), reverse=True)
        r = pick[0]
        out["main"] = {"harness": r.get("harness"), **r["usage"]}
    elif rows:
        main = [r for r in rows if r.get("block_id") == main_block]
        if main:
            out["main"] = {"harness": main[0].get("harness")}
    return out


PANE_ORDER = {"needs_you": 0, "working": 1}


def agent_panes(rows, window=None):
    """One entry per agent pane, the ones that need Tal first, then working, then the rest;
    within each, panes on the bar's own tab first, then the most recently updated."""
    panes = []
    for r in rows:
        group = "idle" if r.get("stale") else r.get("group") or ("working" if r.get("state") == "working" else "idle")
        if group not in PANE_ORDER:
            group = "idle"
        children = r.get("children") if isinstance(r.get("children"), dict) else {}
        panes.append({
            "group": group, "state": str(r.get("state") or ""),
            "name": clean(str(r.get("title") or r.get("pane") or r.get("harness") or "agent")),
            "msg": clean(str(r.get("msg") or "")),
            "sub": sum(v for k, v in children.items() if k == "working" and isinstance(v, int)),
            "here": bool(window) and r.get("window_id") == window,
            "updated": str(r.get("updated_at") or ""),
        })
    panes.sort(key=lambda a: a["updated"], reverse=True)
    panes.sort(key=lambda a: (PANE_ORDER.get(a["group"], 2), not a["here"]))
    return panes


def parse_usage(data):
    """{provider: {"5h": pct, "wk": pct}} from `ai-usage status --json`."""
    out = {}
    for card in data.get("cards", []) if isinstance(data, dict) else []:
        if not isinstance(card, dict):
            continue
        meters = {}
        for m in card.get("meters", []) or []:
            if not isinstance(m, dict) or not isinstance(m.get("used_percent"), (int, float)):
                continue
            label = str(m.get("label", "")).lower()
            if "week" in label:
                meters["wk"] = m["used_percent"]
            elif "session" in label or "hour" in label or "5h" in label:
                meters["5h"] = m["used_percent"]
        if card.get("provider"):
            out[str(card["provider"])] = meters
    return out


class UsageCache:
    """ai-usage output cached in a file shared by every bar, refreshed at most every ttl s."""

    def __init__(self, path=None, command=None, ttl=USAGE_TTL):
        self.path = Path(path or CACHE)
        self.command = command or [AI_USAGE, "status", "--json"]
        self.ttl = ttl
        self._busy = threading.Lock()

    def read(self):
        """(usage or None, age in s or None). Never runs anything."""
        data = read_json(self.path, {})
        at = data.get("fetched_at")
        if not isinstance(at, (int, float)):
            return None, None
        usage = data.get("usage") if data.get("ok") else None
        return usage, time.time() - at

    def stale(self):
        _, age = self.read()
        return age is None or age >= self.ttl

    def refresh(self, force=False):
        """Run ai-usage if the cache is stale. Safe to call from a thread."""
        if not force and not self.stale():
            return
        if not self._busy.acquire(blocking=False):
            return
        try:
            r = run(self.command, timeout=20)
            entry = {"fetched_at": time.time(), "ok": False}
            if r.returncode != 0:
                note_error(f"ai-usage: exit {r.returncode}: {(r.stderr or '').strip()[:200]}")
            if r.returncode == 0:
                try:
                    entry = {"fetched_at": time.time(), "ok": True, "usage": parse_usage(json.loads(r.stdout))}
                except ValueError:
                    pass
            try:
                self.path.parent.mkdir(parents=True, exist_ok=True)
                write_json(self.path, entry)
            except OSError:
                pass
        finally:
            self._busy.release()


def fetch_board():
    r = run([REXBOARD, "ls", "--json"], timeout=8)
    if r.returncode != 0:
        note_error(f"rexboard ls: exit {r.returncode}: {(r.stderr or '').strip()[:200]}")
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        note_error("rexboard ls: output is not JSON")
        return None


# ---- drawing --------------------------------------------------------------------

COLORS = {
    "picture": "35", "done": "32", "doing": "33", "blocked": "31", "todo": "90",
    "review": "36", "promote": "34", "land": "94",
}
GLYPHS = {
    "picture": "p", "done": "+", "doing": ">", "blocked": "!", "todo": ".",
    "review": "r", "promote": "P", "land": "L",
}
CELL = "▮"  # ▮
ELLIPSIS = "…"
SEP = " │ "  # │


def char_width(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1


def text_width(s):
    return sum(char_width(c) for c in s)


class Line:
    """A row of styled spans: [(text, sgr or None)]."""

    def __init__(self, spans=None):
        self.spans = [s for s in (spans or []) if s[0]]

    def add(self, text, style=None):
        if text:
            self.spans.append((text, style))
        return self

    def extend(self, other):
        self.spans.extend(other.spans)
        return self

    def width(self):
        return sum(text_width(t) for t, _ in self.spans)

    def plain(self):
        return "".join(t for t, _ in self.spans)

    def truncate(self, width):
        """At most width cells; a cut line ends with an ellipsis."""
        if self.width() <= width:
            return Line(list(self.spans))
        if width <= 0:
            return Line()
        room, out = width - 1, []
        for text, style in self.spans:
            keep = ""
            for c in text:
                w = char_width(c)
                if w > room:
                    room = 0
                    break
                keep += c
                room -= w
            if keep:
                out.append((keep, style))
            if room <= 0 and keep != text:
                break
        # Drop trailing spaces before the ellipsis.
        while out and out[-1][0].endswith(" "):
            t, s = out[-1]
            t = t.rstrip(" ")
            out[-1] = (t, s)
            if not t:
                out.pop()
        out.append((ELLIPSIS, "2"))
        return Line(out)

    def render(self, color=True):
        if not color:
            return self.plain()
        parts = []
        for text, style in self.spans:
            parts.append(f"\x1b[{style}m{text}\x1b[0m" if style else text)
        return "".join(parts)


def ago(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def event_key(e):
    return e.get("status") if e.get("kind") == "objective" else e.get("kind")


def strip_line(events, width, color=True):
    """The newest events that fit in width cells, oldest dropped; a leading … marks the cut."""
    if width <= 0 or not events:
        return Line()
    shown = events if len(events) <= width else events[-(width - 1):] if width > 1 else []
    line = Line()
    if len(shown) < len(events):
        line.add(ELLIPSIS, "2")
    for e in shown:
        key = event_key(e) or "todo"
        line.add(CELL if color else GLYPHS.get(key, "?"), COLORS.get(key))
    # Merge neighbouring spans of the same style to keep the output short.
    merged = []
    for text, style in line.spans:
        if merged and merged[-1][1] == style:
            merged[-1] = (merged[-1][0] + text, style)
        else:
            merged.append((text, style))
    return Line(merged)


def pct_style(p):
    return "31" if p >= 80 else "33" if p >= 50 else None


def fmt_pct(p):
    return f"{p:.0f}%" if isinstance(p, (int, float)) else "–"


def id_parts(model):
    """(fixed head, shrinkable objective) for the ticket segment."""
    session, obj = model["session"], model["objectives"]
    head = Line()
    ticket = session.get("ticket") if isinstance(session, dict) else None
    head.add(str(ticket) if ticket else "scratch", "1")
    if obj["total"]:
        head.add(f" {obj['done']}/{obj['total']}", "2")
    if obj["blocked"]:
        head.add(f" !{obj['blocked']} blocked", "1;31")
    tail = Line()
    if obj["doing"]:
        tail.add(" ▸ ", "33").add(clean(obj["doing"]))
        if obj["doing_more"]:
            tail.add(f" +{obj['doing_more']}", "2")
    return head, tail


def agents_line(agents, compact=False):
    """Agents by state. compact: `w1 y1 i2 +4` (working, need you, idle, subagents)."""
    line = Line()
    if agents is None:
        return line.add("agents –", "2")
    parts = [("working", "33", "w"), ("waiting", "1;35", "y"), ("idle", "2", "i")]
    first = True
    for key, style, short in parts:
        if agents[key]:
            word = f"{short}{agents[key]}" if compact else \
                f"{agents[key]} {key if key != 'waiting' else 'need you'}"
            line.add("" if first else " ").add(word, style)
            first = False
    if agents["sub"]:
        line.add(" +").add(f"{agents['sub']}" if compact else f"{agents['sub']} sub", "33")
    if first and not agents["sub"]:
        line.add("no agents", "2")
    return line


def usage_line(usage, harness=None, compact=False):
    """Plan usage, the main agent's provider first. compact: that provider only."""
    line = Line()
    if not usage:
        return line.add("5h – wk –", "2")
    order = ["codex", "claude"] if harness == "codex" else ["claude", "codex"]
    if compact:
        order = [p for p in order if p in usage][:1]
    first = True
    for provider in order:
        meters = usage.get(provider)
        if meters is None:
            continue
        if not first:
            line.add(" ")
            line.add("cx " if provider == "codex" else "cl ", "2")
        five, week = meters.get("5h"), meters.get("wk")
        if first or five is not None:
            line.add("5h ", "2").add(fmt_pct(five), pct_style(five) if five is not None else "2")
            line.add(" ")
        line.add("wk ", "2").add(fmt_pct(week), pct_style(week) if week is not None else "2")
        first = False
    return line if not first else line.add("5h – wk –", "2")


def model_line(main):
    line = Line()
    if not main:
        return line
    name = main.get("model_display") or main.get("model")
    if name:
        line.add(str(name), "36")
        if main.get("effort"):
            line.add(f" {main['effort']}", "2")
    ctx = main.get("ctx_pct")
    if isinstance(ctx, (int, float)):
        line.add(" ctx " if name else "ctx ", "2").add(f"{ctx:.0f}%", pct_style(ctx))
    tok = main.get("tok")
    if isinstance(tok, (int, float)) and tok:
        line.add(f" {tok / 1000:.0f}k tok" if tok < 10 ** 6 else f" {tok / 10 ** 6:.1f}M tok", "2")
    return line


PANE_STYLE = {"needs_you": ("need you", "1;35"), "working": ("working", "33"), "idle": ("idle", "2")}


def panes_line(panes, width):
    """Each agent pane: state, name (cut to 20 cells), message. The first pane, the
    one most likely to need Tal, gets half the row; the rest share the other half."""
    line = Line()
    if not panes:
        return line.add("no agent panes in this session", "2")
    for i, a in enumerate(panes):
        if len(panes) == 1:
            share = width
        elif i == 0:
            share = max(24, width // 2)
        else:
            share = max(20, (width - width // 2) // min(len(panes) - 1, 2))
        word, style = PANE_STYLE.get(a["group"], ("idle", "2"))
        if a["group"] == "idle" and a["state"] in ("done", "unknown"):
            word = a["state"]
        item = Line().add(word, style).add(" ").extend(Line([(a["name"], "1")]).truncate(20))
        if a["sub"]:
            item.add(f" +{a['sub']}", "33")
        if a["msg"]:
            item.add(": ", "2").add(a["msg"])
        if i:
            line.add(SEP, "2")
        line.extend(item.truncate(share - (text_width(SEP) if i else 0)))
        if line.width() >= width:
            break
    return line


def path_line(path):
    """The current goal's parents, outermost first."""
    line = Line()
    if not path:
        return line
    parts = path.split(" / ")
    for i, part in enumerate(parts):
        if i:
            line.add(" \u203a ", "2")
        line.add(clean(part), "33" if i == len(parts) - 1 else None)
    return line


def join(*lines, sep=SEP):
    out = Line()
    for line in lines:
        if not line.spans:
            continue
        if out.spans:
            out.add(sep, "2")
        out.extend(line)
    return out


def fit_id(head, tail, room, min_tail=12):
    """The ticket segment in at most room cells, cutting the goal text first."""
    full = Line(head.spans + tail.spans)
    if full.width() <= room:
        return full
    keep = max(room - head.width(), min(min_tail, tail.width()))
    return Line(head.spans + tail.truncate(keep).spans).truncate(room)


def compose(model, width, rows, color=True, now=None):
    """The frame as a list of `rows` Line objects."""
    now = now if now is not None else time.time()
    width, rows = max(1, int(width)), max(1, int(rows))
    head, tail = id_parts(model)
    main = (model["agents"] or {}).get("main")
    mline = model_line(main)
    branch = Line()
    if isinstance(model["session"], dict) and model["session"].get("branch"):
        branch.add(str(model["session"]["branch"]), "2")
    events = model["events"]
    right = join(agents_line(model["agents"]), usage_line(model["usage"], (main or {}).get("harness")),
                 mline, branch)
    # When the full status would squeeze the goal below ~24 cells, use short forms.
    if width - right.width() - head.width() < 24 + (len(events) + 3 if rows == 1 else 0):
        right = join(agents_line(model["agents"], compact=True),
                     usage_line(model["usage"], (main or {}).get("harness"), compact=True), mline)

    if rows == 1:
        sep_w = text_width(SEP)
        avail = width - right.width() - (sep_w if right.spans else 0)
        id_full = head.width() + tail.width()
        strip_want = len(events) + (sep_w if events else 0)
        if id_full + strip_want <= avail:
            id_room = id_full
        else:
            id_room = max(min(id_full, head.width() + 12), avail - min(strip_want, 8 + sep_w))
        ident = fit_id(head, tail, id_room)
        strip_room = avail - ident.width() - sep_w
        strip = strip_line(events, min(strip_room, len(events) + 1), color) if strip_room > 0 else Line()
        line = join(ident, strip, right)
        return [line.truncate(width)]

    # Two or more rows: identity and status on top, history underneath.
    sep_w = text_width(SEP)
    ident = fit_id(head, tail, max(width - right.width() - sep_w, head.width() + 12))
    top = join(ident, right).truncate(width)
    strip_w = min(len(events), max(0, min(width - 2, max(width * 2 // 3, width - 40))))
    bottom = strip_line(events, strip_w, color)
    if events:
        last = events[-1]
        label = last.get("kind") if last.get("kind") != "objective" else last.get("status")
        bottom.add("  ").add(f"{label}: ", COLORS.get(event_key(last)))
        bottom.add(clean(last.get("text", ""))).add(f" {ago(now - last['t'])} ago", "2")
    else:
        bottom.add("no history yet", "2")
    out = [top, bottom.truncate(width)]
    if rows >= 3:
        out.append(panes_line((model["agents"] or {}).get("panes") or [], width).truncate(width)
                   if model["agents"] is not None else Line().add("agents \u2013", "2"))
    if rows >= 4:
        out.append(path_line(model["objectives"].get("doing_path")).truncate(width))
    return out + [Line() for _ in range(rows - len(out))]


