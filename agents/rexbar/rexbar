class Source:
    """Reads the session's files again only when their mtimes change."""

    def __init__(self, directory, write_log=True):
        self.directory = directory
        self.write_log = write_log
        self.stamps = None
        self.session, self.history, self.objectives, self.log = {}, {}, None, {"events": []}

    def paths(self):
        d = self.directory
        return [d / "session.json", d / "objectives.md", d / "show" / "history.json",
                d / "bar" / "objectives-log.json"]

    def poll(self):
        """True if anything changed since the last poll."""
        if self.directory is None:
            return False
        stamps = [mtime(p) for p in self.paths()]
        if stamps == self.stamps:
            return False
        self.stamps = stamps
        d = self.directory
        self.session = read_json(d / "session.json", {})
        self.history = read_json(d / "show" / "history.json", {})
        try:
            self.objectives = parse_objectives((d / "objectives.md").read_text(errors="replace"))
        except OSError:
            self.objectives = None
        if self.write_log and d.is_dir():
            try:
                self.log = update_log(d, self.objectives, self.session)
            except OSError:
                self.log = read_json(d / "bar" / "objectives-log.json", {"events": []})
        else:
            self.log = read_json(d / "bar" / "objectives-log.json", {"events": []})
        self.stamps = [mtime(p) for p in self.paths()]
        return True

    def model(self, board, usage, session_id, window=None):
        rows = board_rows(session_id, board) if board is not None else None
        main_block = self.session.get("main_block") if isinstance(self.session, dict) else None
        return {
            "session": self.session,
            "objectives": summarize_objectives(self.objectives or []),
            "events": collect_events(self.session, self.history, self.log),
            "agents": agent_summary(rows, main_block, window) if rows is not None else None,
            "usage": usage,
        }


# ---- Rex ----------------------------------------------------------------------------

def rex(*args, timeout=20):
    """Run rex and return parsed JSON; raises RuntimeError on failure."""
    out = run([REX, *args], timeout=timeout)
    if out.returncode != 0:
        raise RuntimeError(f"rex {' '.join(args[:3])}: {(out.stderr or out.stdout).strip()}")
    try:
        return json.loads(out.stdout) if out.stdout.strip() else {}
    except ValueError:
        return {}


def api(method, payload):
    return rex("api", "call", method, json.dumps(payload))


def inspect(session):
    return rex("session", "inspect", session, "--json")


def find_window(view, window_id):
    for w in view.get("windows", []) if isinstance(view, dict) else []:
        if w.get("window_id") == window_id:
            return w
    return None


def tiled_layer(window):
    for layer in window.get("layers", []):
        if layer.get("kind") == "tiled":
            return layer
    return None


def walk(node, out=None):
    """Leaves of a layout node as (block_id, rect)."""
    out = [] if out is None else out
    if not isinstance(node, dict):
        return out
    if node.get("block_id"):
        out.append((node["block_id"], node.get("rect") or [0, 0, 1, 1]))
    split = node.get("split")
    if isinstance(split, dict):
        walk(split.get("before"), out)
        walk(split.get("after"), out)
    return out


def find_bar(window, recorded=None):
    """The recorded bar block if it is still a tiled pane of this tab, else None.

    A pane is never taken as the bar by its label: a pane someone else labelled
    "Bar" is not rexbar's to close or resize.
    """
    layer = tiled_layer(window) if window else None
    if not layer or not recorded:
        return None
    blocks = {b.get("block_id") for b in layer.get("blocks", [])}
    return recorded if recorded in blocks else None


class Unverified(RuntimeError):
    """Rex or ps did not answer, so whether a pane is the bar is unknown. Retryable."""


EX_TEMPFAIL = 75


def process_args(pid):
    """The command line of a local process; "" when no local process has that
    pid (ps ran and found none: another host's process, or it exited); None when
    ps itself failed."""
    if not isinstance(pid, int):
        return ""
    r = run(["/bin/ps", "-o", "args=", "-p", str(pid)], timeout=5)
    if r.returncode == 0:
        return r.stdout.strip()
    if r.returncode == 1 and not r.stdout.strip():
        return ""
    return None


def runs_rexbar(session, block):
    """Whether the block's foreground program is `rexbar run` for this session:
    True, False (Rex answered and shows something else), or None (unknown:
    the process query or ps failed)."""
    try:
        info = rex("block", "call", "-s", session, "-b", block, "process", timeout=8)
    except RuntimeError:
        return None
    proc = info.get("foreground") or info.get("child") if isinstance(info, dict) else None
    if not isinstance(proc, dict):
        return False if isinstance(info, dict) and info else None
    script = str(proc.get("script") or "")
    if Path(script).name != "rexbar":
        return False
    args = process_args(proc.get("pid"))
    if args is None:
        return None
    if not args:
        return True  # not a local process (another host): the script is all Rex reports
    words = args.split()
    return "run" in words and session in words


def owned_bar(session, window_id, directory, view=None, retry_delay=0.5):
    """(bar block or None, view). The bar is the block recorded in bar/state.json
    for this tab, still on the tab and still running `rexbar run`. A record whose
    block is gone, or confirmed to run something else, is dropped, so `panes`
    lists only live bars. When the check cannot be made (twice), the record is
    kept and Unverified is raised, so nothing is created, closed or resized."""
    view = view if view is not None else inspect(session)
    window = find_window(view, window_id)
    state_path = directory / "bar" / "state.json"
    state = read_json(state_path, {})
    panes = state.get("panes") if isinstance(state.get("panes"), dict) else {}
    recorded = panes.get(window_id)
    bar = find_bar(window, recorded)
    if bar:
        ours = runs_rexbar(session, bar)
        if ours is None:
            time.sleep(retry_delay)
            ours = runs_rexbar(session, bar)
        if ours is None:
            raise Unverified(f"could not check that {bar} still runs rexbar (Rex or ps did not answer); "
                             "nothing changed, try again")
        if not ours:
            bar = None
    if recorded and not bar:
        panes.pop(window_id, None)
        state["panes"] = panes
        if state_path.parent.is_dir():
            write_json(state_path, state)
    return bar, view


def bar_split(layer, bar):
    """(split node, before-side block) when bar is the after side of the layer's top split."""
    root = layer.get("layout") or {}
    split = root.get("split")
    if not isinstance(split, dict) or split.get("direction") != "vertical":
        return None, None
    if (split.get("after") or {}).get("block_id") != bar:
        return None, None
    leaves = walk(split.get("before"))
    return (split, leaves[0][0]) if leaves else (None, None)


def terminal_size(session, block):
    """(rows, owned) for a terminal block; owned is False when no app sizes it."""
    try:
        r = api("com.superlogical.terminal.size", {"session_id": session, "block_id": block})
    except RuntimeError:
        return None, False
    rows = r.get("rows") if isinstance(r.get("rows"), int) else None
    return rows, bool(r.get("owner"))


def tab_rows(session, layer, exclude=None):
    """Estimated rows of the whole tab, from its tallest pane's real size."""
    leaves = [(b, rect) for b, rect in walk(layer.get("layout") or {}) if b != exclude]
    leaves.sort(key=lambda x: -(x[1][3] if len(x[1]) == 4 else 0))
    for block, rect in leaves[:2]:
        rows, owned = terminal_size(session, block)
        if rows and owned and len(rect) == 4 and rect[3] > 0:
            return rows / rect[3]
    return DEFAULT_TAB_ROWS


def bar_fraction(rows_total, target=TARGET_ROWS):
    """Fraction of the tab for the bar: target rows plus one row of pane chrome."""
    return min(0.5, max(0.01, (target + 1) / max(rows_total, 1)))


def resize(session, before, bar, fraction):
    api("session.resize_pane", {"session_id": session, "direction": "vertical",
                                "before_block_id": before, "after_block_id": bar,
                                "ratio": round(1 - fraction, 4)})


def fit(session, window_id, bar=None, target=TARGET_ROWS, own_rows=None, settle=0.4, tries=3):
    """Size the bar to `target` rows. Returns a dict describing what it did.

    The first guess comes from the tallest pane's rows. Then, when Rex reports
    real sizes (an app shows the tab), it measures the bar and corrects the
    fraction, a few times. The model is rows = fraction * tab_rows - 1 (one row
    goes to the divider, as one column does between side-by-side panes), so the
    correction is (target + 1) / (measured + 1).
    """
    view = inspect(session)
    window = find_window(view, window_id)
    if not window:
        raise RuntimeError(f"{window_id} is not a tab of {session}")
    layer = tiled_layer(window)
    if not layer or not bar:
        raise RuntimeError("no bar on this tab")
    split, before = bar_split(layer, bar)
    if not split:
        raise RuntimeError("the bar is not the bottom of the tab's top split")
    current = 1 - float(split.get("ratio", 0.95))
    rows, owned = (own_rows, True) if own_rows else terminal_size(session, bar)
    if owned and rows:
        fraction = current * (target + 1) / (rows + 1) if rows != target else current
    else:
        fraction = bar_fraction(tab_rows(session, layer, exclude=bar), target)
    fraction = min(0.5, max(0.01, fraction))
    resize(session, before, bar, fraction)
    measured = None
    for _ in range(tries):
        time.sleep(settle)
        before_rows = measured
        measured, owned = terminal_size(session, bar)
        if not owned or not measured or measured == target:
            break
        if measured == before_rows or (measured > target and measured == rows):
            break  # the app's minimum pane height: a smaller ratio changes nothing
        fraction = min(0.5, max(0.01, fraction * (target + 1) / (measured + 1)))
        resize(session, before, bar, fraction)
    return {"block": bar, "ratio": round(1 - fraction, 4), "rows": measured, "sized_by_app": owned}


def resolve_session(args):
    """session:UUID from --session, or from $REX_SESSION when Rex knows it."""
    session = args.session
    if not session:
        env = os.environ.get("REX_SESSION")
        if env:
            env = env if env.startswith("session:") else "session:" + env
            try:
                inspect(env)
                session = env
            except RuntimeError:
                pass
    if not session:
        fail("pass --session (REX_SESSION is unset or names no live session)")
    if not session.startswith("session:"):
        session = "session:" + session
    if session_dir(session) is None:
        fail(f"invalid Rex session id: {session!r}")
    return session


def resolve_window(args, session, view=None, required=True):
    window = args.window
    if not window and args.block:
        view = view or inspect(session)
        block = args.block if args.block.startswith("block:") else "block:" + args.block
        for w in view.get("windows", []):
            if any(b.get("block_id") == block for layer in w.get("layers", []) for b in layer.get("blocks", [])):
                window = w["window_id"]
    if window and not window.startswith("window:"):
        window = "window:" + window
    if required and not window:
        fail("pass --window (or --block of a pane on that tab)")
    return window


def bar_command(session, window):
    return [sys.executable, str(HERE / "rexbar"), "run", "--session", session, "--window", window, "--fit"]


def open_bar(session, window_id, directory, settle=0.6):
    """Create (or find) the bar on a tab. Call with the session lock held."""
    view = inspect(session)
    window = find_window(view, window_id)
    if not window:
        raise RuntimeError(f"{window_id} is not a tab of {session}")
    layer = tiled_layer(window)
    if not layer:
        raise RuntimeError(f"{window_id} has no tiled panes")
    bar_dir = directory / "bar"
    bar_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    bar, _ = owned_bar(session, window_id, directory, view)
    state_path = bar_dir / "state.json"
    state = read_json(state_path, {})
    panes = state.get("panes") if isinstance(state.get("panes"), dict) else {}
    created = False
    if not bar:
        root = layer.get("layout") or {}
        anchor = (root.get("split") or {}).get("split_id") or root.get("block_id")
        if not anchor:
            raise RuntimeError("cannot find the tab's layout root")
        rows_total = tab_rows(session, layer)
        fraction = bar_fraction(rows_total)
        result = api("session.new_split", {
            "session_id": session, "anchor_id": anchor, "direction": "vertical", "side": "after",
            "ratio": round(1 - fraction, 4), "focus": False,
            "layout": {"block": {"flavor": SHELL_FLAVOR, "label": LABEL, "options": {
                "command": bar_command(session, window_id), "cwd": str(directory)}}},
        })
        bar = (result.get("block_ids") or [None])[0]
        if not bar:
            raise RuntimeError("rex did not return the new block")
        created = True
    panes[window_id] = bar
    state["panes"] = panes
    state["session"] = session
    write_json(state_path, state)
    sizing = None
    try:
        if created and settle:
            time.sleep(settle)  # the app re-balances a new split on the tab it shows
        sizing = fit(session, window_id, bar)
    except RuntimeError as e:
        sizing = {"error": str(e)}
    return {"pane": bar, "window": window_id, "created": created, "fit": sizing}


def close_bar(session, window_id, directory):
    """Close the bar on a tab, if any. Call with the session lock held."""
    bar, _ = owned_bar(session, window_id, directory)
    if bar:
        rex("block", "close", "-s", session, bar)
    state_path = directory / "bar" / "state.json"
    state = read_json(state_path, {})
    panes = state.get("panes") if isinstance(state.get("panes"), dict) else {}
    if window_id in panes:
        panes.pop(window_id)
        state["panes"] = panes
        write_json(state_path, state)
    return {"pane": bar, "window": window_id, "closed": bool(bar)}


def session_lock(directory):
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    return Lock(directory / ".lock")


def cmd_pane(args):
    session = resolve_session(args)
    directory = session_dir(session)
    window = resolve_window(args, session)
    try:
        with session_lock(directory):
            if args.command == "open":
                out = open_bar(session, window, directory)
            elif args.command == "close":
                out = close_bar(session, window, directory)
            elif args.command == "toggle":
                if owned_bar(session, window, directory)[0]:
                    out = {"action": "close", **close_bar(session, window, directory)}
                else:
                    out = {"action": "open", **open_bar(session, window, directory)}
            else:  # fit
                bar, _ = owned_bar(session, window, directory)
                if not bar:
                    raise RuntimeError("no bar of rexbar's on this tab")
                out = fit(session, window, bar)
    except Unverified as e:
        fail(str(e), EX_TEMPFAIL)
    except RuntimeError as e:
        fail(str(e))
    print(json.dumps(out))


# ---- once / run ----------------------------------------------------------------------

def size_of(stream):
    try:
        return os.get_terminal_size(stream.fileno())
    except (OSError, ValueError, AttributeError):
        return os.terminal_size((80, TARGET_ROWS))


def paint(lines, columns):
    """One frame: cursor home, then each row followed by erase-to-end-of-line.

    compose() returns exactly one line per screen row, so nothing is erased
    below. A row that fills the width gets no erase: with wrap off the cursor
    sits on the last column, and erasing from there (EL or ED) would delete
    the row's last cell.
    """
    rows = []
    for line in lines:
        text = line.render(True)
        rows.append(text if line.width() >= columns else text + "\x1b[K")
    return "\x1b[H" + "\r\n".join(rows)


def log_errors(directory, seen):
    """Append new source errors to bar/run.log (kept under 64 KB)."""
    new = ERRORS[seen:]
    if not new or directory is None or not (directory / "bar").is_dir():
        return len(ERRORS)
    path = directory / "bar" / "run.log"
    try:
        if path.exists() and path.stat().st_size > 65536:
            path.write_text("")
        with open(path, "a") as f:
            for at, message in new:
                f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S', time.localtime(at))} pid {os.getpid()} {message}\n")
    except OSError:
        pass
    return len(ERRORS)


def frame_text(lines, color):
    return "\n".join(line.render(color) for line in lines)


def cmd_once(args):
    session = resolve_session(args)
    directory = session_dir(session)
    source = Source(directory if directory.is_dir() else None)
    source.poll()
    cache = UsageCache()
    if cache.stale():
        cache.refresh()
    usage, _ = cache.read()
    board = fetch_board()
    model = source.model(board, usage, session, args.window)
    width = args.width or shutil.get_terminal_size((120, 2)).columns
    rows = args.rows or 1
    print(frame_text(compose(model, width, rows, color=not args.no_color), not args.no_color))


class Ticker(threading.Thread):
    """Runs fn every interval s in the background; wakes the main loop on change."""

    def __init__(self, interval, fn, wake):
        super().__init__(daemon=True)
        self.interval, self.fn, self.wake = interval, fn, wake
        self.value = None
        self.first = threading.Event()  # set after the first run, whatever it returned

    def run(self):
        while True:
            try:
                value = self.fn()
            except Exception:  # noqa: BLE001 - a source must never stop the bar
                value = None
            if value != self.value:
                self.value = value
                self.wake()
            self.first.set()
            time.sleep(self.interval)


def cmd_run(args):
    session = resolve_session(args)
    directory = session_dir(session)
    out = sys.stdout
    rfd, wfd = os.pipe()
    os.set_blocking(wfd, False)
    os.set_blocking(rfd, False)

    def wake(*_):
        try:
            os.write(wfd, b"x")
        except OSError:
            pass

    signal.set_wakeup_fd(wfd)
    signal.signal(signal.SIGWINCH, lambda *_: None)
    stop = []
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.append(1))

    cache = UsageCache()
    board = Ticker(BOARD_TTL, fetch_board, wake)

    def usage_fn():
        cache.refresh()
        return cache.read()[0]

    usage = Ticker(USAGE_TTL / 4, usage_fn, wake)  # refresh() itself keeps to the TTL
    usage.value = cache.read()[0]  # the cached numbers, even if stale, until the refresh
    board.start()
    usage.start()
    # rexboard answers in tens of milliseconds; wait briefly so the first frame
    # is not a placeholder (which Rex keeps in scrollback when the pane resizes).
    board.first.wait(1.5)

    fitter = {"last": 0.0, "tries": 0, "rows": None, "busy": False}

    def maybe_fit(rows):
        if not args.fit or fitter["busy"]:
            return
        if rows == args.fit_rows:
            fitter["tries"] = 0
            return
        if rows != fitter["rows"]:
            fitter["rows"], fitter["tries"] = rows, 0
        if fitter["tries"] >= 3 or time.time() - fitter["last"] < 3:
            return
        fitter["tries"] += 1
        fitter["last"] = time.time()
        fitter["busy"] = True

        def work():
            try:
                state = read_json(directory / "bar" / "state.json", {})
                recorded = (state.get("panes") or {}).get(args.window) if isinstance(state.get("panes"), dict) else None
                # Only the recorded bar resizes itself: a `rexbar run` started by
                # hand in some other pane never moves a border.
                block = os.environ.get("REX_BLOCK")
                if not block or block != recorded:
                    return
                # Only an app that shows the tab sizes panes from the layout; a
                # tab nobody shows keeps its default size, so there is nothing to fit.
                if args.window and block and terminal_size(session, block)[1]:
                    fit(session, args.window, block, target=args.fit_rows, own_rows=rows, tries=0)
            except Exception:  # noqa: BLE001
                pass
            finally:
                fitter["busy"] = False
        threading.Thread(target=work, daemon=True).start()

    source = Source(directory if directory.is_dir() else None)
    out.write("\x1b[?25l\x1b[?7l\x1b[2J")
    out.flush()
    last, last_poll, last_size, logged = None, 0.0, None, 0
    try:
        while not stop:
            now = time.time()
            if now - last_poll >= 1:
                source.poll()
                last_poll = now
            size = size_of(out)
            if size != last_size:
                if last_size is not None:
                    out.write("\x1b[H\x1b[2J\x1b[3J")  # drop the old frame and its scrollback
                last_size = size
                last = None
                maybe_fit(size.lines)
            logged = log_errors(directory, logged)
            model = source.model(board.value, usage.value, session, args.window)
            lines = compose(model, size.columns, size.lines, color=True, now=now)
            text = paint(lines, size.columns)
            if text != last:
                out.write(text)
                out.flush()
                last = text
            ready, _, _ = select.select([rfd], [], [], 1.0)
            if ready:
                try:
                    while os.read(rfd, 512):
                        pass
                except (BlockingIOError, OSError):
                    pass
    finally:
        out.write("\x1b[0m\x1b[?7h\x1b[?25h")
        out.flush()


def main():
    parser = argparse.ArgumentParser(prog="rexbar", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    for name, text in [("run", "render the bar in this pane until killed"),
                       ("once", "print one frame"),
                       ("open", "create the bar pane on a tab"),
                       ("close", "remove the bar pane from a tab"),
                       ("toggle", "open or close the bar pane"),
                       ("fit", "size the bar pane to its rows again")]:
        p = sub.add_parser(name, help=text)
        p.add_argument("--session", help="Rex session id (default: $REX_SESSION if Rex knows it)")
        p.add_argument("--window", help="the tab (window id)")
        if name == "once":
            p.add_argument("--width", type=int, help="columns (default: the terminal's)")
            p.add_argument("--rows", type=int, help="rows (default 1)")
            p.add_argument("--no-color", action="store_true", help="plain text, letters for history cells")
        if name == "run":
            p.add_argument("--fit", action="store_true", help="resize the pane to --fit-rows when its height drifts")
            p.add_argument("--fit-rows", type=int, default=TARGET_ROWS, help=f"rows to keep (default {TARGET_ROWS})")
        if name in ("open", "close", "toggle", "fit"):
            p.add_argument("--block", help="a pane on the tab, instead of --window")
    args = parser.parse_args()
    if args.command == "once":
        cmd_once(args)
    elif args.command == "run":
        cmd_run(args)
    else:
        cmd_pane(args)


if __name__ == "__main__":
    main()
