def open_pr(worktree, branch):
    out = run(["gh", "pr", "list", "--head", branch, "--state", "open", "--json", "url,number"], cwd=worktree)
    if out.returncode != 0:
        fail(f"gh pr list: {out.stderr.strip()}")
    prs = json.loads(out.stdout or "[]")
    return prs[0]["url"] if prs else None


def pr_body(directory, state):
    objectives = directory / "objectives.md"
    body = objectives.read_text().strip() if objectives.exists() else ""
    link = f"Linear: [{state.get('ticket')}]({state['url']})" if state.get("url") else f"Linear: {state.get('ticket')}"
    return (body + "\n\n" if body else "") + link + "\n"


def own_session():
    env = os.environ.get("REX_SESSION")
    return session_id(env) if env and is_session_id(env) else None


def close_session(session):
    """Close the session after this process has printed its result."""
    if session == own_session():
        # Closing our own session ends this process; let it finish first.
        subprocess.Popen(["/bin/sh", "-c", 'sleep 1; rex kill "$0"', session], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return "closing"
    rex("kill", session)
    return "closed"


def archive(directory):
    check_state_dir(directory)
    ARCHIVE.mkdir(parents=True, exist_ok=True, mode=0o700)
    target = ARCHIVE / directory.name
    if target.exists():
        target = ARCHIVE / f"{directory.name}-{int(time.time())}"
    directory.replace(target)
    return target


def verify_branch(state, ticket, worktree, branch):
    """The session's worktree really is this ticket's branch, in the recorded repo."""
    if not branch_matches_ticket(branch, ticket):
        fail(f"branch {branch} is not a {ticket} branch; fix it with `rexwork adopt --repo WORKTREE`")
    if not Path(worktree).is_dir():
        fail(f"worktree {worktree} is missing")
    current = git("symbolic-ref", "-q", "--short", "HEAD", cwd=worktree, check=False)
    if current != branch:
        fail(f"{worktree} is on {current}, not {branch}")
    if state.get("repo"):
        _, main = repo_root(worktree)
        if str(main) != str(Path(state["repo"]).resolve()):
            fail(f"{worktree} belongs to {main}, not the recorded repo {state['repo']}")


def land_plan(args, session, directory):
    """What land would do, from state and git read now: (plan, digest, state). Read-only.
    The digest covers the session's live association (kind, ticket, repo, worktree, branch
    and branch head) whatever the chosen variant does, the commit that would be pushed and
    every action, so a plan Tal saw can be checked before it runs."""
    state = read_state(directory)
    if not state:
        fail(f"no rexwork state for {session}; run `rexwork adopt` in that session first")
    if state.get("owner") == "symphony":
        fail("this session is owned by Symphony, which lands its own work (PR and Linear state); "
             "rexwork land does not touch it")
    label = state.get("label") or session
    alive = session in live_sessions()
    close = not args.keep and alive
    ticketed = state.get("kind") == "ticketed"
    actions = []
    plan = {"session_id": session, "label": label, "kind": state.get("kind"), "ticket": None, "repo": None,
            "worktree": None, "branch": None, "head": None, "no_branch": False, "publish": False,
            "close": close, "archive": not ticketed and not args.keep, "push": False, "pr": False,
            "linear": False, "live": live_association(state), "actions": actions}

    if ticketed:
        ticket, worktree, branch = state.get("ticket"), state.get("worktree"), state.get("branch")
        if not ticket:
            fail("ticketed session without a ticket in session.json")
        plan["ticket"] = ticket
        has_branch = bool(worktree and branch)
        if has_branch and args.linear_only:
            fail(f"{ticket} has branch {branch} attached (in {worktree}); --linear-only is only for a "
                 "ticket without a branch. Land without it to push and open the PR, or with --no-pr "
                 "to push without a PR")
        if has_branch:
            verify_branch(state, ticket, worktree, branch)
            changes = git("status", "--porcelain", cwd=worktree, check=False)
            if changes:
                fail(f"{worktree} has uncommitted changes; commit or remove them first:\n{changes}")
            if "origin" not in (git("remote", cwd=worktree) or "").split():
                fail(f"{worktree} has no origin remote")
            head = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=worktree, check=False)
            if not head:
                fail(f"{branch} has no commit in {worktree}; nothing to push")
            plan.update(repo=state.get("repo"), worktree=worktree, branch=branch, head=head, push=True,
                        pr=not args.no_pr, publish=True)
            actions.append(f"git push origin {head[:12]}:refs/heads/{branch} (exactly that commit, "
                           f"in {worktree}; never forced)")
            actions.append("skip the PR (--no-pr)" if args.no_pr else
                           f"open a PR for {branch} if none is open: title {pr_title(state)!r}")
        else:
            plan["no_branch"] = True
            if args.linear_only:
                actions.append("no branch or PR: Linear only (--linear-only)")
            elif args.no_linear:
                actions.append("no branch or PR, and Linear skipped (--no-linear)")
            elif args.dry_run:
                actions.append("no branch or PR: land refuses without --linear-only")
            else:
                fail(f"{ticket} has no branch attached, so land would push nothing and open no PR. "
                     "Attach one with `rexwork adopt --repo WORKTREE`, or pass --linear-only to move "
                     f"{ticket} to In Review without a PR")
        if args.no_linear:
            actions.append("skip Linear (--no-linear)")
        else:
            actions.append(f"{'comment the PR link on ' + ticket + ' and ' if has_branch and not args.no_pr else ''}"
                           f"move {ticket} to In Review")
            plan.update(linear=True, publish=True)
    elif args.keep:
        actions.append(f"keep {directory} (scratch with --keep: nothing is archived while the session stays open)")
    else:
        actions.append(f"move {directory} to {ARCHIVE}/")
    kept = held_worktree(state)
    if kept and plan["archive"]:
        fail(f"this session holds {kept['worktree']}; run `rexwork release` before archiving it")
    if kept:
        plan["worktree_kept"] = kept["worktree"]
        actions.append(f"keep the worktree {kept['worktree']} ({kept['provider']}) for review fixes; "
                       f"`rexwork release --session {session}` frees it once the PR is merged")

    if close:
        actions.append(f"close Rex session {label!r} ({session})")
    elif not alive:
        actions.append("the Rex session is already gone")
    else:
        actions.append("keep the session open (--keep)")
    digest = hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
    return plan, digest, state


def live_association(state):
    """The session's association as it is now, for the digest: any change to it (a branch
    attached, a different worktree, a new commit) invalidates a confirmation."""
    worktree, branch = state.get("worktree"), state.get("branch")
    head = None
    if worktree and branch and Path(worktree).is_dir():
        head = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=worktree, check=False)
    return {"kind": state.get("kind"), "ticket": state.get("ticket"), "repo": state.get("repo"),
            "worktree": worktree, "branch": branch, "head": head}


def pr_title(state):
    return f"{state.get('ticket')}: {state.get('title') or state.get('ticket')}"


def confirm_land_tty(label, plan):
    sys.stderr.write(f"Land {label!r}:\n" + "".join(f"  - {p}\n" for p in plan["actions"]) + "Proceed? [y/N] ")
    sys.stderr.flush()
    if sys.stdin.readline().strip().lower() not in ("y", "yes"):
        fail("not landed")


# Fields of session.json a running land depends on; checked again before each external write.
LAND_FIELDS = ("kind", "ticket", "repo", "worktree", "branch", "owner", "label", "title", "url")


def recheck(directory, planned, before, plan=None):
    """Stop before BEFORE if session.json (or the branch head) no longer matches the plan."""
    now = read_state(directory)
    changed = [k for k in LAND_FIELDS if now.get(k) != planned.get(k)]
    if changed:
        fail(f"session.json changed ({', '.join(changed)}) while landing; stopped before {before}. "
             "The plan changed; look again")
    if plan and plan.get("push"):
        head = git("rev-parse", "--verify", "--quiet", f"refs/heads/{plan['branch']}", cwd=plan["worktree"],
                   check=False)
        if head != plan["head"]:
            fail(f"{plan['branch']} moved from {plan['head']} to {head}; stopped before {before}. "
                 "The plan changed; look again")


def cmd_land(args):
    """Plan, show, confirm, then recompute the plan under the session lock and run it only
    if it is the plan that was shown (or the one --expect names)."""
    session, _ = caller(args)
    directory, _ = require_state(session)
    if args.dry_run:
        plan, digest, _ = land_plan(args, session, directory)
        emit(land_result(plan, digest, dry_run=True))
        return
    shown = args.expect
    if not args.yes:
        plan, digest, _ = land_plan(args, session, directory)
        if not plan_does_anything(plan):
            return report_noop(plan, digest)
        if not (sys.stdin.isatty() and sys.stderr.isatty()):
            fail("land publishes or closes: pass --yes after checking `rexwork land --dry-run`, "
                 "or run it in a terminal")
        if shown and shown != digest:
            fail("the plan changed since --expect was computed; look again (`rexwork land --dry-run`)")
        confirm_land_tty(plan["label"], plan)
        shown = digest
    with session_lock(directory):
        plan, digest, state = land_plan(args, session, directory)
        if shown and not secrets.compare_digest(shown, digest):
            fail("the plan changed; look again. Now it is:\n" + "\n".join(f"  - {a}" for a in plan["actions"]))
        if not plan_does_anything(plan):
            return report_noop(plan, digest)
        run_land(args, session, directory, plan, digest, state)


def plan_does_anything(plan):
    return plan["publish"] or plan["close"] or plan["archive"]


def report_noop(plan, digest):
    note("nothing to do: " + "; ".join(plan["actions"]))
    emit({**land_result(plan, digest, dry_run=False), "noop": True})


def land_result(plan, digest, dry_run):
    out = {"session_id": plan["session_id"], "label": plan["label"], "kind": plan["kind"], "dry_run": dry_run,
           "plan": plan["actions"], "digest": digest,
           "planned": {k: plan[k] for k in ("ticket", "repo", "worktree", "branch", "head", "close", "archive")}}
    if plan["no_branch"]:
        out["no_branch"] = True
    if plan.get("worktree_kept"):
        out["worktree_kept"] = plan["worktree_kept"]
    return out


def run_land(args, session, directory, plan, digest, state):
    """Runs under the session lock, after the plan was checked."""
    result = land_result(plan, digest, dry_run=False)
    ticket, worktree, branch = plan["ticket"], plan["worktree"], plan["branch"]
    if plan["kind"] == "ticketed":
        pr_url = None
        if plan["push"]:
            recheck(directory, state, "git push", plan)
            verify_branch(read_state(directory), ticket, worktree, branch)  # again, just before pushing
            sha = plan["head"]
            # Push exactly the confirmed commit; no `+`, no --force, so a non-fast-forward fails.
            out = run(["git", "push", "origin", f"{sha}:refs/heads/{branch}"], cwd=worktree, timeout=180)
            if out.returncode != 0:
                fail(f"git push: {out.stderr.strip()}")
            result["pushed"] = branch
            result["pushed_sha"] = sha
            up = run(["git", "branch", f"--set-upstream-to=origin/{branch}", branch], cwd=worktree)
            if up.returncode != 0:
                note(f"pushed, but could not set the upstream of {branch}: {up.stderr.strip()}")
            now = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=worktree, check=False)
            if now and now != sha:
                result["local_ahead"] = now
                note(f"pushed {sha[:12]}; local {branch} is now at {now[:12]}, not pushed")
            if plan["pr"]:
                pr_url = open_pr(worktree, branch)
                if not pr_url:
                    recheck(directory, state, "gh pr create")
                    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
                        f.write(pr_body(directory, state))
                    out = run(["gh", "pr", "create", "--head", branch, "--title", pr_title(state),
                               "--body-file", f.name], cwd=worktree, timeout=120)
                    os.unlink(f.name)
                    if out.returncode != 0:
                        fail(f"gh pr create: {out.stderr.strip()}")
                    pr_url = out.stdout.strip().splitlines()[-1]
                result["pr_url"] = pr_url
        if plan["linear"]:
            recheck(directory, state, "the Linear update")
            issue = get_issue(ticket)
            if pr_url:
                comment_issue(issue, f"PR: {pr_url}")
            set_issue_state(issue, "In Review")
            result["linear"] = "In Review"
        update_state(directory, landed_at=int(time.time()), pr_url=pr_url)
    if plan.get("worktree_kept"):
        note(f"kept {plan['worktree_kept']}; run `rexwork release --session {session}` once the PR is merged")
    if plan["archive"]:
        recheck(directory, state, "archiving")
        result["archived_to"] = str(archive(directory))
    if plan["close"] and session == own_session():
        result["session"] = "closing"
        emit(result)
        close_session(session)
        return
    if plan["close"]:
        result["session"] = close_session(session)
    emit(result)


# ---- release ----------------------------------------------------------------

def held_worktree(state):
    """The worktree rexwork created (or leased) for this session and still holds, or None.
    Only a `worktree_created` record for the recorded path counts; a path name alone never
    makes a worktree rexwork's."""
    record = state.get("worktree_created")
    if (state.get("worktree") and isinstance(record, dict) and record.get("provider") in OWNED_PROVIDERS
            and same_path(record.get("path"), state["worktree"])):
        return {"worktree": state["worktree"], "provider": record["provider"],
                "lease_id": state.get("lease_id") or record.get("lease_id"), "branch": state.get("branch"),
                "repo": state.get("repo") or record.get("repo"), "since": record.get("at") or state.get("worktree_at"),
                "record": record}
    return None


def describe_age(since):
    if not since:
        return "unknown age"
    s = max(0, int(time.time()) - int(since))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return f"{s // size}{unit}"
    return f"{s}s"


def release_session(args):
    """The state dir to release: by ticket (any session dir that holds its worktree), else
    the caller's session (--session or $REX_SESSION)."""
    if args.ticket:
        ticket = normalize_ticket(args.ticket)
        if not ticket:
            fail(f"not a ticket id: {args.ticket}")
        found = []
        for path in sorted(SESSIONS.glob("*/session.json")) if SESSIONS.exists() else []:
            if not is_session_id(path.parent.name):
                continue
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                continue
            if isinstance(data, dict) and data.get("ticket") == ticket and held_worktree(data):
                found.append(path.parent)
        if not found:
            fail(f"no rexwork session holds a worktree for {ticket}")
        if len(found) > 1:
            fail(f"several sessions hold a worktree for {ticket}: "
                 + ", ".join(session_id(d.name) for d in found) + "; pass --session")
        return session_id(found[0].name), check_state_dir(found[0])
    session, _ = caller(args)
    return session, state_dir(session)


def worktree_risks(path):
    """What removing PATH would lose: uncommitted changes, commits on no origin branch."""
    risks = []
    changes = git("status", "--porcelain", cwd=path, check=False)
    if changes is None:
        return [f"{path} is not a readable git worktree"]
    if changes:
        risks.append(f"uncommitted changes:\n{changes}")
    if "origin" not in (git("remote", cwd=path, check=False) or "").split():
        risks.append("no origin remote, so its commits can not be checked against it")
    else:
        unpushed = git("log", "--oneline", "HEAD", "--not", "--remotes=origin", cwd=path, check=False)
        if unpushed:
            risks.append(f"commits on no origin branch:\n{unpushed}")
    return risks


def release_plan(session, directory, state, force):
    held = held_worktree(state)
    if not held:
        if state.get("worktree"):
            fail(f"rexwork did not create {state['worktree']} ({state.get('worktree_provider') or 'adopted'}); "
                 "it leaves it alone")
        fail("this session holds no worktree")
    if state.get("owner") == "symphony":
        fail("this session is owned by Symphony, which manages its own workspace")
    path, provider, lease_id = held["worktree"], held["provider"], held["lease_id"]
    plan = {"session_id": session, "worktree": path, "provider": provider, "lease_id": lease_id,
            "branch": held["branch"], "repo": held["repo"], "exists": Path(path).is_dir(), "risks": [],
            "lease": None, "actions": []}
    actions = plan["actions"]
    if provider == "treehouse":
        if not lease_id:
            fail(f"no lease id recorded for {path}; return it by hand (`treehouse return` in {path})")
        rows = treehouse_status(held["repo"] or path)
        row = next((r for r in rows if same_path(r.get("path"), path)), None)
        current = (row or {}).get("lease_id")
        if current and current != lease_id:
            fail(f"{path} is now leased by {row.get('lease_holder')!r} (lease {current}), not by this session; "
                 "not touching it")
        plan["lease"] = "held" if current == lease_id else "gone"
    if provider == "git" and plan["exists"]:
        problem = identity_problem(held["record"])
        if problem:
            fail(f"{problem}; rexwork removes only the worktree it created, so it leaves this one alone "
                 "(remove it by hand if it should go)")
    if plan["exists"]:
        plan["risks"] = worktree_risks(path)
    if plan["risks"] and not force:
        fail(f"{path} has work that would be lost; commit and push it first, or pass --force (asks in a "
             "terminal):\n" + "\n".join(plan["risks"]))
    if provider == "treehouse" and plan["lease"] == "gone":
        actions.append(f"forget {path}: treehouse no longer has lease {lease_id} on it")
    elif provider == "treehouse":
        actions.append(f"treehouse return {'--force ' if force else ''}--if-lease-id {lease_id} {path}"
                       + (" (discards the work listed above)" if force and plan["risks"] else ""))
    elif plan["exists"]:
        actions.append(f"git worktree remove {'--force ' if force else ''}{path}"
                       + (" (discards the work listed above)" if force and plan["risks"] else ""))
    else:
        actions.append(f"forget {path} (already gone); run `git worktree prune` in {held['repo']} yourself "
                       "if its metadata should go too")
    actions.append(f"keep branch {held['branch']} (never deleted)")
    return plan


def cmd_release(args):
    """Free the worktree rexwork made for a ticket: treehouse return by lease id, or
    git worktree remove. Refuses when work would be lost, unless --force after a typed yes."""
    session, directory = release_session(args)
    with session_lock(directory):
        state = read_state(directory)
        plan = release_plan(session, directory, state, args.force)
        if args.dry_run:
            emit({"dry_run": True, **plan})
            return
        if args.force and plan["risks"]:
            if not (sys.stdin.isatty() and sys.stderr.isatty()):
                fail("--force discards work; run it in a terminal and type yes")
            sys.stderr.write(f"Release {plan['worktree']} and DISCARD:\n" + "\n".join(plan["risks"])
                             + "\n" + "".join(f"  - {a}\n" for a in plan["actions"]) + "Type yes: ")
            sys.stderr.flush()
            if sys.stdin.readline().strip() != "yes":
                fail("not released")
        elif not args.yes:
            if not (sys.stdin.isatty() and sys.stderr.isatty()):
                fail("release removes a worktree: pass --yes after checking `rexwork release --dry-run`, "
                     "or run it in a terminal")
            sys.stderr.write(f"Release {plan['worktree']}:\n" + "".join(f"  - {a}\n" for a in plan["actions"])
                             + "Proceed? [y/N] ")
            sys.stderr.flush()
            if sys.stdin.readline().strip().lower() not in ("y", "yes"):
                fail("not released")
        force = bool(args.force and plan["risks"])
        path, repo = plan["worktree"], plan["repo"] or plan["worktree"]
        if plan["provider"] == "treehouse":
            if plan["lease"] == "held":
                treehouse("return", *(["--force"] if force else []), "--if-lease-id", plan["lease_id"], path,
                          cwd=repo if Path(repo).is_dir() else None, timeout=300)
        elif plan["exists"]:
            git("worktree", "remove", *(["--force"] if force else []), path, cwd=repo)
        # A worktree already gone: only the record is cleared; never a repo-wide prune.
        left = [s for s in (state.get("pending") or []) if s != "worktree"]
        update_state(directory, worktree=None, lease_id=None, worktree_provider=None, worktree_created=None,
                     pending=left or None, worktree_error=None,
                     released={"worktree": path, "provider": plan["provider"], "lease_id": plan["lease_id"],
                               "branch": plan["branch"], "at": int(time.time())})
    emit({"released": path, "provider": plan["provider"], "lease_id": plan["lease_id"], "branch": plan["branch"],
          "actions": plan["actions"]})


