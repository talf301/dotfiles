def open_show(session, block):
    show = os.environ.get("REXWORK_SHOW") or str(SHOW)  # tests point this at a failing program
    out = run([sys.executable, show, "--open-pane", "--session", session, "--block", block], timeout=40)
    if out.returncode != 0:
        fail(f"show --open-pane: {out.stderr.strip()}")
    try:
        data = json.loads(out.stdout)
    except ValueError:
        fail("show --open-pane printed no JSON")
    if not isinstance(data, dict) or not data.get("pane"):
        fail("show --open-pane returned no pane")
    return data


def soft(warnings, what, fn, *args):
    """Run a cosmetic step after the command is running: a failure is a warning, not an error."""
    try:
        return fn(*args)
    except Failure as e:
        message = f"{what}: {e}"
        warnings.append(message)
        note(f"warning: {message}")
        return None
    except Exception as e:  # noqa: BLE001 - the command is already running; never fail the start
        message = f"{what}: {type(e).__name__}: {e}"
        warnings.append(message)
        note(f"warning: {message}")
        return None


def show_pane(warnings, session, block, wanted=True):
    """The Show pane's block id with --show; None without it (the pane opens with the
    first `show FILE`, or `show --toggle`), or (with a warning) if it could not be opened."""
    if not wanted:
        return None
    show = soft(warnings, "Show pane not opened", open_show, session, block)
    return show["pane"] if show else None


def open_bar(session, window):
    """`rexbar open` for the tab: the status bar along its bottom (idempotent). Call it
    without the session lock held: rexbar takes that lock itself."""
    bar = os.environ.get("REXWORK_BAR") or str(REXBAR)  # tests point this at a stub
    out = run([sys.executable, bar, "open", "--session", session, "--window", window], timeout=40)
    if out.returncode != 0:
        fail(f"rexbar open: {out.stderr.strip()}")
    try:
        data = json.loads(out.stdout)
    except ValueError:
        fail("rexbar open printed no JSON")
    if not isinstance(data, dict) or not data.get("pane"):
        fail("rexbar open returned no pane")
    return data


def bar_pane(warnings, args, session, window):
    """The bar's block id; None with --no-bar, without a tab, or (with a warning) on failure."""
    if getattr(args, "no_bar", False) or not window:
        return None
    bar = soft(warnings, "status bar not opened", open_bar, session, window)
    return bar["pane"] if bar else None


STATE_MARK = "@STATE_DIR@"

