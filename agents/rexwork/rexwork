# Options that take a value, so `--title --` is a title, not the start of COMMAND.
VALUE_OPTIONS = {"--scratch", "--draft", "--cwd", "--repo", "--title", "--agent", "--prompt", "--owner",
                 "--harness", "--model",
                 "--reuse-tab", "--name", "--session", "--block"}


def split_command(argv):
    """rexwork's own arguments, and the words after the first bare `--` (passed on unchanged).
    A value option becomes `--opt=VALUE`, so argparse accepts values such as `-x` or `--`."""
    own, i = [], 0
    while i < len(argv):
        if argv[i] == "--":
            return own, argv[i + 1:]
        if argv[i] in VALUE_OPTIONS and i + 1 < len(argv):
            own.append(f"{argv[i]}={argv[i + 1]}")
            i += 2
        else:
            own.append(argv[i])
            i += 1
    return own, []


def main(argv=None):
    argv, command = split_command(list(sys.argv[1:] if argv is None else argv))
    parser = argparse.ArgumentParser(prog="rexwork", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("start", help="start a session in the standard layout")
    p.add_argument("ticket", nargs="?", help="ticket id, such as TAL-123")
    p.add_argument("--scratch", metavar="NAME")
    p.add_argument("--draft", metavar="NAME")
    p.add_argument("--ask", action="store_true", help="ask for the kind and name on the terminal")
    p.add_argument("--cwd")
    p.add_argument("--repo", help="git repo for the ticket's worktree (default: the repo --cwd is in)")
    p.add_argument("--no-worktree", action="store_true", help="never create or adopt a worktree")
    p.add_argument("--no-bar", action="store_true", help="do not open the status bar")
    p.add_argument("--show", action="store_true",
                   help="open the Show pane now (default: it opens with the first picture)")
    p.add_argument("--title", help="ticket title (skips the Linear lookup)")
    p.add_argument("--agent", choices=AGENTS, help="default claude; with --ask it preselects (else asked)")
    p.add_argument("--no-agent", action="store_true")
    p.add_argument("--harness", choices=HARNESSES,
                   help="how the agent pane runs the agent (default: rexchat; native with --owner; "
                        "$REXWORK_HARNESS overrides the default)")
    p.add_argument("--model", help="the agent's model (native: --model; rexchat: --model, its model option)")
    p.add_argument("--prompt", help="first prompt for the agent")
    p.add_argument("--no-linear", action="store_true", help="do not change the ticket in Linear")
    p.add_argument("--focus", action="store_true", help="show the new session in the Rex app")
    p.add_argument("--owner", help="who started the session (such as symphony); kept in session.json")
    p.add_argument("--reuse-tab", metavar="NAME",
                   help="if the ticket's session exists, run COMMAND in a new tab NAME and leave its tabs alone")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("adopt", help="add rexwork state to the caller's existing session")
    p.add_argument("--name")
    p.add_argument("--title")
    p.add_argument("--repo")
    p.add_argument("--agent", choices=AGENTS)
    p.add_argument("--harness", choices=HARNESSES, help="default: rexchat if one runs in the pane, else unchanged")
    p.add_argument("--no-bar", action="store_true", help="do not open the status bar")
    p.add_argument("--show", action="store_true",
                   help="open the Show pane now (default: it opens with the first picture)")
    p.add_argument("--session")
    p.add_argument("--block")
    p.set_defaults(func=cmd_adopt)

    p = sub.add_parser("promote", help="turn a scratch session into a Linear ticket")
    p.add_argument("--template", action="store_true", help="print the draft skeleton")
    p.add_argument("--file", action="store_true", help="file the draft (needs Tal's confirmation)")
    p.add_argument("--clear-filing", action="store_true",
                   help="clear an interrupted filing that Linear has no issue for (asks in a terminal)")
    p.add_argument("--recover", action="store_true",
                   help="finish an interrupted or partial promotion by its recorded issue id (asks in a terminal)")
    p.add_argument("--draft", help="draft file (default: <state dir>/ticket-draft.md)")
    p.add_argument("--repo", help="git repo for the ticket's worktree (default: the session's repo)")
    p.add_argument("--no-worktree", action="store_true", help="file the ticket without creating a worktree")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-focus", action="store_true")
    p.add_argument("--request-draft", action="store_true", help="with no draft, ask the agent to write one")
    p.add_argument("--stdin", action="store_true", help=argparse.SUPPRESS)  # the float's request
    p.add_argument("--preview", action="store_true", help=argparse.SUPPRESS)  # parse stdin, write nothing
    p.add_argument("--session")
    p.add_argument("--block")
    p.set_defaults(func=cmd_promote)

    p = sub.add_parser("land", help="push, open the PR, update Linear, close the session")
    p.add_argument("--yes", action="store_true", help="confirm: push, open the PR, update Linear, close")
    p.add_argument("--keep", action="store_true", help="leave the session open (still needs --yes to publish)")
    p.add_argument("--linear-only", action="store_true",
                   help="no push or PR: only move the ticket to In Review (only for a ticket with no branch attached)")
    p.add_argument("--dry-run", action="store_true", help="print the plan and its digest; change nothing")
    p.add_argument("--json", action="store_true", help="accepted for clarity; output is always JSON")
    p.add_argument("--expect", metavar="DIGEST",
                   help="with --yes: run only if the plan's digest (from --dry-run) is unchanged")
    p.add_argument("--no-pr", action="store_true")
    p.add_argument("--no-linear", action="store_true")
    p.add_argument("--session")
    p.set_defaults(func=cmd_land)

    p = sub.add_parser("release", help="free the worktree or treehouse slot rexwork made for a ticket")
    p.add_argument("ticket", nargs="?", help="ticket id; finds the session dir that holds its worktree")
    p.add_argument("--yes", action="store_true", help="confirm without a terminal prompt")
    p.add_argument("--dry-run", action="store_true", help="print the plan; change nothing")
    p.add_argument("--force", action="store_true",
                   help="discard uncommitted or unpushed work (asks for a typed yes in a terminal)")
    p.add_argument("--session")
    p.set_defaults(func=cmd_release)

    p = sub.add_parser("status", help="this session's state")
    p.add_argument("--json", action="store_true")
    p.add_argument("--session")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("ls", help="every session with rexwork state")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_ls)

    args = parser.parse_args(argv)
    if command and args.cmd != "start":
        parser.error("only `start` takes -- COMMAND")
    args.command = command
    try:
        args.func(args)
    except Failure as e:
        note(str(e))
        return 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
