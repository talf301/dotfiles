def recorded_ticket(sid):
    """The ticket in SID's session.json; None if it has none. An unreadable or invalid
    session.json counts as a different ticket ('?'), so its session is never matched."""
    try:
        path = state_dir(sid) / "session.json"
    except Failure:
        return "?"
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return "?"
    return data.get("ticket") if isinstance(data, dict) else "?"


def find_ticket_session(ticket):
    """The live session for TICKET: by session.json, else by label. Durable state wins: a
    session whose session.json records another ticket is never matched by its label."""
    live = live_sessions()
    for path in sorted(SESSIONS.glob("*/session.json")) if SESSIONS.exists() else []:
        if not is_session_id(path.parent.name):
            continue
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        sid = session_id(path.parent.name)
        if isinstance(data, dict) and data.get("ticket") == ticket and sid in live:
            return sid
    for sid, s in live.items():
        if is_session_id(sid) and label_matches_ticket(s.get("label"), ticket):
            if recorded_ticket(sid) in (None, ticket):
                return sid
            note(f"session {s.get('label')!r} ({sid}) is labelled {ticket} but its session.json records "
                 f"{recorded_ticket(sid)}; not reusing it")
    return None


def main_block_of(session, state):
    view = inspect(session)
    recorded = state.get("main_block")
    if recorded and window_of(view, recorded):
        return recorded, window_of(view, recorded)["window_id"]
    window = next((w for w in view.get("windows", []) if w["window_id"] == view.get("active_window_id")),
                  (view.get("windows") or [None])[0])
    if not window:
        fail(f"{session} has no tabs")
    blocks = [b for b in tiled_blocks(window) if b.get("label") != "Show"]
    if not blocks:
        fail(f"{session} has no main pane")
    return blocks[0]["block_id"], window["window_id"]


SESSION_LOCK_WAIT = 25   # Symphony gives `rexwork start` 60 s in all
WORKTREE_LOCK_WAIT = 30


@contextlib.contextmanager
def ticket_lock(ticket, kind, wait):
    """A per-ticket flock under the state root (`locks/TAL-N.<kind>.lock`). "session" is
    held only across discovery and registration, so it is short; "worktree" across
    worktree acquisition, which can take minutes, and Symphony never takes it."""
    directory = SESSIONS.parent / "locks"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(directory / f"{ticket}.{kind}.lock", "w") as lock:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    what = ("acquiring its worktree (a treehouse lease can take minutes)" if kind == "worktree"
                            else "registering its session")
                    fail(f"another `rexwork start {ticket}` is {what}; waited {wait}s. Run it again when "
                         "that one has finished")
                time.sleep(0.2)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def start_ticket(args):
    ticket = normalize_ticket(args.ticket)
    if not ticket:
        fail(f"not a ticket id: {args.ticket}")
    if args.owner == "symphony" and args.repo:
        fail("--owner symphony never creates a worktree (Symphony owns its workspace); drop --repo")
    # Symphony's path acquires no worktree, so it never waits behind a long treehouse lease.
    worktree_lock = (contextlib.nullcontext() if args.owner == "symphony"
                     else ticket_lock(ticket, "worktree", WORKTREE_LOCK_WAIT))
    with worktree_lock:
        with ticket_lock(ticket, "session", SESSION_LOCK_WAIT):
            existing = find_ticket_session(ticket)
            if existing and args.reuse_tab:
                return on_existing(args, ticket, existing)
        if existing:
            return on_existing(args, ticket, existing)
        return start_new(args, ticket)


def on_existing(args, ticket, existing, tree=None):
    """The one dispatch for "the ticket's session exists", at the first lookup and at the
    recheck after the worktree: --reuse-tab runs COMMAND in a new tab, else the session is
    reused. A worktree TREE this start just acquired that the session can not take is given
    back, never dropped."""
    if args.reuse_tab:
        returned = give_back(tree) if tree else None
        return reuse_in_new_tab(args, ticket, existing, returned)
    return start_existing(args, ticket, existing, tree)


JUST_MADE = ("lease", "create branch", "add existing branch", "track remote branch")


def give_back(tree):
    """Undo a worktree this start just made (a fresh lease or `git worktree add`, so it
    is clean) because no session can record it. Returns what happened, or None when TREE
    holds nothing this start made."""
    if not tree or not tree.get("worktree_created") or tree.get("action") not in JUST_MADE:
        return None
    path, repo, lease_id = tree["worktree"], tree.get("repo"), tree.get("lease_id")
    try:
        if tree.get("worktree_provider") == "treehouse":
            treehouse("return", "--if-lease-id", lease_id, path, cwd=repo, timeout=300)
            what = f"returned treehouse slot {path} (lease {lease_id})"
        else:
            git("worktree", "remove", path, cwd=repo)
            what = f"removed worktree {path} (branch {tree.get('branch')} kept)"
        note(f"{what}: the session that appeared meanwhile does not take it")
        return what
    except Failure as e:
        how = (f"treehouse return --if-lease-id {lease_id} {path}" if tree.get("worktree_provider") == "treehouse"
               else f"git worktree remove {path}")
        note(f"could not give back {path} ({e}); nothing records it, so run `{how}` by hand")
        return f"not given back: {e}; run `{how}`"


def no_worktree_message(ticket, cause, base):
    return (f"{ticket} expects a worktree and has none, so no session or agent was started: {cause}. "
            f"Fix that and run `rexwork start {ticket}` again (it reuses a lease already taken), or pass "
            f"--no-worktree to work in {base} deliberately")


def enclosing_slot(path):
    """The outermost linked worktree (a `.git` file) between the treehouse root and PATH:
    the pool slot PATH is in, whatever is nested inside it. None outside the root."""
    path = Path(path).resolve()
    if not in_treehouse_root(path):
        return None
    slot = None
    for directory in [path, *path.parents]:
        if not in_treehouse_root(directory):
            break
        if (directory / ".git").is_file():
            slot = directory
    return str(slot) if slot else None


def usable_problem(tree, ticket):
    """None if TREE's worktree is a live checkout the agent may start in: its own git top
    level, of the expected repo, on the ticket's branch. Else what is wrong."""
    path, branch = tree.get("worktree"), tree.get("branch")
    if not path or not Path(path).is_dir():
        return f"{path} does not exist"
    top = git("rev-parse", "--show-toplevel", cwd=path, check=False)
    if not top or not same_path(top, path):
        return (f"{path} is not a git checkout of its own (git top level: {top or 'none'}); a stale "
                "`git worktree list` entry? Check it and run `git worktree prune` by hand")
    try:
        _, main = repo_root(path)
    except Failure as e:
        return f"{path}: {e}"
    if tree.get("repo") and not same_path(main, tree["repo"]):
        return f"{path} belongs to {main}, not {tree['repo']}"
    current = git("symbolic-ref", "-q", "--short", "HEAD", cwd=path, check=False)
    if current != branch or not branch_matches_ticket(branch, ticket):
        return f"{path} is on {current or 'a detached HEAD'}, not the {ticket} branch {branch}"
    return None


def launch_dir(cwd, ticket, tree=None, strict=False):
    """CWD, unless it is inside a treehouse slot not held by rexwork for TICKET (any slot
    for a scratch session): then the slot's main checkout. Every start checks the final
    launch directory with this, so an agent never starts in someone else's slot."""
    path = Path(cwd)
    # The slot by path first: a clone nested in a slot reports itself as its own main checkout.
    top = enclosing_slot(path) or (git("rev-parse", "--show-toplevel", cwd=path, check=False)
                                   if path.is_dir() else None)
    if not top:
        if in_treehouse_root(path):
            fail(f"{path} is under the treehouse root but is not a readable checkout; not starting there")
        return path
    try:
        _, main = repo_root(top)
    except Failure:
        if in_treehouse_root(path):
            fail(f"{top} is under the treehouse root but is not a readable checkout; not starting there")
        return path
    if same_path(top, main) and not in_treehouse_root(path):
        return path  # the main checkout is never a pool slot
    try:
        provider = worktree_provider(main, top)
    except Failure:
        provider = "git"
    lease = tree.get("lease_id") if tree and same_path(tree.get("worktree"), top) else None
    try:
        if ticket:
            check_slot(main, top, ticket, provider, lease)
        elif pool_row(main, top, provider) is not None:
            raise WorktreeBlocked(f"{top} is a treehouse slot and this session has no lease on it", top)
    except WorktreeBlocked as e:
        if strict:  # a ticket's worktree: never redirect to the main checkout
            raise
        note(f"{e}; starting in the main checkout {main} instead")
        return Path(main)
    except Failure as e:  # treehouse status failed for a worktree outside the pool root
        note(f"could not check whether {top} is a treehouse slot ({e}); it is outside {treehouse_root()}")
    return path


def start_existing(args, ticket, existing, tree=None):
    """The ticket's session exists: re-add its Show pane and bar, finish a pending
    worktree, and (with TREE, a worktree acquired while it appeared) record it if the
    session has none."""
    if args.command:
        note("the ticket's session exists; -- COMMAND was not run (pass --reuse-tab NAME to run it in a new tab)")
    warnings = []
    # A worktree this start just acquired is settled before anything that can fail.
    try:
        directory = state_dir(existing)
        state = read_state(directory)
        if tree and tree.get("worktree") and not state.get("worktree") and state.get("owner") != "symphony":
            state = update_state(directory, **tree_fields(tree), pending=None, worktree_error=None)
        elif tree:
            returned = give_back(tree)
            if returned:
                warnings.append(returned)
    except BaseException:
        give_back(tree)
        raise
    main, window = main_block_of(existing, state)
    show = show_pane(warnings, existing, main, args.show) or live_block(existing, state.get("show_block"))
    bar = bar_pane(warnings, args, existing, window) or state.get("bar_block")
    label = (live_sessions().get(existing) or {}).get("label") or state.get("label") or ticket
    # find_ticket_session never returns a session recording another ticket.
    updates = {"session_id": existing, "window_id": window, "main_block": main, "show_block": show,
               "bar_block": bar, "label": label, "kind": "ticketed", "ticket": ticket}
    if not state.get("created_at"):
        updates["created_at"] = int(time.time())
    state = update_state(directory, **updates)
    pending = retry_pending_worktree(directory, state, ticket)
    state = read_state(directory)
    write_objectives(directory, label, ticket, state.get("url"))
    note(f"reusing session {label!r} ({existing}) for {ticket}")
    if args.focus:
        focus_session(existing, window)
    emit({**result_of(existing, state, directory), "reused": True, "warnings": warnings,
          "pending": pending})
    if pending:
        fail(f"worktree still pending: {state.get('worktree_error')}")


def start_new(args, ticket):
    if args.title:
        title, url, issue = args.title, None, None
    else:
        issue = get_issue(ticket)
        title, url = issue["title"], issue["url"]
    label = ticket_label(ticket, title)
    base = Path(args.cwd or caller_cwd()).expanduser()
    repo = default_repo(args, base)
    tree, pending, tree_error, _ = worktree_for_start(repo, ticket, title) if repo else ({}, [], None, None)
    if repo and (pending or not tree.get("worktree")):
        # A ticket that expects a worktree never starts without one: the agent would run in
        # the main checkout. Nothing is created; a lease already taken is reused on rerun.
        fail(no_worktree_message(ticket, tree_error or "no worktree was found or made", base))
    # From here a fresh worktree is either recorded on a session, passed to one, or given
    # back, whatever exits: never left where nothing records it.
    handed = []
    try:
        return launch_new(args, ticket, title, url, issue, label, base, repo, tree, handed)
    finally:
        if not handed and tree:
            give_back(tree)


def launch_new(args, ticket, title, url, issue, label, base, repo, tree, handed):
    cwd = Path(tree.get("worktree") or base).expanduser()
    if repo:
        problem = usable_problem(tree, ticket)
        if problem:
            fail(no_worktree_message(ticket, problem, base))
        try:
            cwd = launch_dir(cwd, ticket, tree, strict=True)
        except WorktreeBlocked as e:
            fail(no_worktree_message(ticket, str(e), base))
    else:
        cwd = launch_dir(cwd, ticket, tree)
    harness = None
    if args.command:
        command, agent = args.command, None
    elif args.no_agent:
        command, agent = None, None
    else:
        agent = args.agent or "claude"
        command, harness = pane_command(args, agent, args.prompt, cwd)

    linear_note = "skipped (--no-linear)"
    if not args.no_linear:
        issue = issue or get_issue(ticket)
        if issue["state"]["type"] in ("backlog", "unstarted", "triage"):
            set_issue_state(issue, "In Progress")
            linear_note = "set In Progress"
        else:
            linear_note = f"left at {issue['state']['name']}"

    warnings = []
    with ticket_lock(ticket, "session", SESSION_LOCK_WAIT):
        again = find_ticket_session(ticket)  # one may have started while the worktree was made
        if again:
            handed.append(again)  # on_existing records the worktree or gives it back, first thing
            return on_existing(args, ticket, again, tree)
        session, window, main, show = create_session(label, ticket, cwd, command, warnings, args.show)
        handed.append(session)  # the agent runs in the worktree from here on
        directory = state_dir(session)
        fields = dict(session_id=session, window_id=window, main_block=main, show_block=show,
                      label=label, kind="ticketed", ticket=ticket, title=title, url=url,
                      **tree_fields(tree), agent=agent, harness=harness, model=args.model if agent else None,
                      cwd=str(cwd), owner=args.owner,
                      created_at=int(time.time()))
        state = soft(warnings, "session.json not written", lambda: update_state(directory, **fields)) or fields
    bar = bar_pane(warnings, args, session, window)
    if bar:
        state = soft(warnings, "session.json not written", lambda: update_state(directory, bar_block=bar)) or {
            **state, "bar_block": bar}
    if tree.get("worktree_created"):
        soft(warnings, "older sessions not updated", hand_over_worktree, directory, tree["worktree"])
    soft(warnings, "objectives.md not written", write_objectives, directory, label, ticket, url)
    if args.focus:
        soft(warnings, "focus", focus_session, session, window)
    emit({**result_of(session, state, directory), "reused": False, "linear": linear_note,
          "worktree_action": tree.get("action"), "pending": [], "warnings": warnings})


def retry_pending_worktree(directory, state, ticket):
    """A reused session whose worktree step is pending: try it again. Returns what is
    still pending."""
    if "worktree" not in (state.get("pending") or []):
        return []
    repo = state.get("repo")
    if not repo:
        return ["worktree"]
    try:
        tree = ensure_worktree(repo, ticket, state.get("title") or ticket, state)
    except WorktreeIncomplete as e:
        update_state(directory, **tree_fields(e.tree), worktree_error=str(e))
        return ["worktree"]
    except Failure as e:
        update_state(directory, worktree_error=str(e))
        return ["worktree"]
    update_state(directory, **tree_fields(tree), pending=None, worktree_error=None)
    if tree.get("worktree_created"):
        hand_over_worktree(directory, tree["worktree"])
    note(f"worktree ready at {tree['worktree']}; the agent pane still runs in {state.get('cwd')}")
    return []


def hand_over_worktree(directory, worktree):
    """An older session dir of this rexwork that records the same owned worktree gives it
    up, so only one session claims (and later releases) it."""
    for path in sorted(SESSIONS.glob("*/session.json")) if SESSIONS.exists() else []:
        other = path.parent
        if other.name == directory.name or not is_session_id(other.name):
            continue
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if (isinstance(data, dict) and held_worktree(data) and same_path(data.get("worktree"), worktree)):
            update_state(other, worktree=None, lease_id=None, worktree_provider=None, worktree_created=None,
                         worktree_moved_to=session_id(directory.name))


def reuse_in_new_tab(args, ticket, session, returned=None):
    """--reuse-tab: leave the reused session alone. Open COMMAND in a new background tab
    with its own Show pane. Nothing in the session's state directory is written: its
    session.json belongs to the session, not to this tab."""
    if not args.command:
        fail("--reuse-tab needs -- COMMAND")
    tab = check_name(args.reuse_tab, "tab name")
    cwd = launch_dir(Path(args.cwd or caller_cwd()).expanduser(), ticket)
    directory = state_dir(session)
    state = read_state(directory)  # read only
    if state.get("ticket") not in (None, ticket):
        fail(f"{session} records {state.get('ticket')}, not {ticket}")  # find_ticket_session prevents this
    # The command is passed as separate words after `--`; Rex never re-splits it.
    out = rex("window", "new", "-s", session, tab, "-c", str(cwd), "--focus=false", "--json",
              "--", *args.command)
    try:
        block = out["block_ids"][0]
    except (KeyError, IndexError, TypeError):
        window = out.get("window_id") if isinstance(out, dict) else None
        if window:
            with contextlib.suppress(Failure):
                rex("window", "close", "-s", session, window)
        fail(f"rex window new returned no pane: {out!r}; closed what it made")
    # COMMAND is running from here on: every later failure is a warning.
    warnings = [returned] if returned else []
    window = out.get("window_id") or (soft(warnings, "tab id not found", window_of, inspect_safe(session), block)
                                      or {}).get("window_id")
    show = show_pane(warnings, session, block, args.show)
    bar = bar_pane(warnings, args, session, window)
    live = soft(warnings, "rex ls", live_sessions) or {}
    label = (live.get(session) or {}).get("label") or state.get("label") or ticket
    note(f"reusing session {label!r} ({session}) for {ticket}: new tab {tab!r}")
    emit({**result_of(session, {**state, "label": label, "ticket": state.get("ticket") or ticket}, directory),
          "reused": True, "warnings": warnings,
          "tab": {"window_id": window, "main_block": block, "show_block": show, "bar_block": bar}})


def inspect_safe(session):
    try:
