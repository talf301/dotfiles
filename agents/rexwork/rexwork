def rexchat_program():
    """The rexchat launcher, or None when it is not installed. REXWORK_REXCHAT names it (tests)."""
    path = os.environ.get("REXWORK_REXCHAT") or shutil.which("rexchat")
    return path if path and os.path.isfile(path) and os.access(path, os.X_OK) else None


def pick_harness(args):
    """--harness, else $REXWORK_HARNESS, else native for an unattended owner (any --owner) and
    rexchat for Tal. rexchat falls back to native, with a note, when it is not installed."""
    harness = (getattr(args, "harness", None) or os.environ.get("REXWORK_HARNESS")
               or ("native" if getattr(args, "owner", None) else "rexchat"))
    if harness not in HARNESSES:
        fail(f"REXWORK_HARNESS={harness!r}: use one of {', '.join(HARNESSES)}")
    if harness == "rexchat" and not rexchat_program():
        note("rexchat is not installed; running the agent natively")
        return "native"
    return harness


def agent_command(agent, prompt=None, harness="native", model=None, cwd=None):
    """The agent pane's command. native: `claude|codex [--model M] [PROMPT]`; rexchat:
    `rexchat --agent A [--cwd DIR] [--model M] [--prompt=PROMPT]`. The wrapper adds the prompt."""
    if harness == "rexchat":
        argv = ["rexchat" if os.environ.get("REXWORK_AGENT_STUB") else rexchat_program(), "--agent", agent]
        argv += ["--cwd", str(cwd)] if cwd else []
        opt = "--prompt="
    else:
        argv, opt = [agent], ""
    argv += ["--model", model] if model else []
    stub = os.environ.get("REXWORK_AGENT_STUB")
    argv = [stub, *argv] if stub else argv
    env = [f"REXWORK_PROMPT={prompt}", f"REXWORK_PROMPT_OPT={opt}"] if prompt else ["-u", "REXWORK_PROMPT"]
    return ["/usr/bin/env", *env, "/bin/sh", "-c", AGENT_WRAPPER, "sh", *argv]


def pane_command(args, agent, prompt, cwd):
    """(command, harness) for an agent pane running AGENT."""
    harness = pick_harness(args)
    return agent_command(agent, prompt, harness, args.model, cwd), harness


def app_client():
    client = os.environ.get("REX_CLIENT")
    if client:
        return client
    out = rex("client", "ls", "--json")
    clients = out.get("clients", []) if isinstance(out, dict) else out
    apps = [c["client_id"] for c in clients if (c.get("info") or {}).get("kind") == "app"
            and c.get("connection_state") == "connected"]
    return apps[0] if apps else None


def focus_session(session, window):
    client = app_client()
    if not client:
        note("no Rex app connected; not switching to the new session")
        return False
    out = run(["rex", "-C", client, "do", "session.select", f"session_id={session}", f"window_id={window}"])
    if out.returncode != 0:
        note(f"could not switch to the session: {out.stderr.strip()}")
        return False
    return True


def live_block(session, block):
    """BLOCK if it is still a pane of SESSION, else None."""
    if not block:
        return None
    return block if window_of(inspect_safe(session), block) else None


def create_session(label, tab, cwd, command, warnings, show=False):
    """A new session running COMMAND. If it can not be read back, the session is closed
    again and this fails, so nothing is left running. Once it runs, a failed Show pane is
    a warning: show_block is None."""
    args = ["new", label, "--window", tab, "-c", str(cwd), "--json"]
    if command:
        args += ["--", *command]
    out = rex(*args)
    try:
        window = out["initial_windows"][0]
        session, main, window_id = out["session_id"], window["block_ids"][0], window["window_id"]
        session_id(session)
    except (KeyError, IndexError, TypeError, Failure) as e:
        sid = out.get("session_id") if isinstance(out, dict) else None
        if isinstance(sid, str) and is_session_id(sid):
            with contextlib.suppress(Failure):
                rex("kill", sid)
        fail(f"rex new returned an unexpected result ({type(e).__name__}: {e}); closed what it made")
    return session, window_id, main, show_pane(warnings, session, main, show)


def pane_cwd(session, block):
    """A pane's working directory: its foreground program's, else its shell's. None if unknown."""
    if not block:
        return None
    out = run(["rex", "block", "call", "-s", session, "-b", block, "process"], timeout=15)
    try:
        info = json.loads(out.stdout) if out.returncode == 0 else {}
    except ValueError:
        info = {}
    fg = info.get("foreground") if isinstance(info, dict) else None
    if isinstance(fg, dict) and fg.get("cwd"):
        return fg["cwd"]
    for proc in (info.get("ancestors") or []) if isinstance(info, dict) else []:
        if isinstance(proc, dict) and proc.get("cwd"):
            return proc["cwd"]
    return None


def caller_cwd():
