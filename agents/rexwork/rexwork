ROOT = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "rexwork"
SESSIONS = ROOT / "sessions"
ARCHIVE = ROOT / "archive"
WORKTREES = Path.home() / ".worktrees"
SHOW = HERE.parent / "show" / "show"
REXBAR = HERE.parent / "rexbar" / "rexbar"
DOCVIEW = HERE.parent / "docview" / "docview"
PROMOTE_LUA = HERE / "promote.lua"
TEAM = "TAL"
BRANCH_PREFIX = "u/tfriedman/"
LINEAR_API = "https://api.linear.app/graphql"
AGENTS = ("claude", "codex")
# How the agent pane runs the agent: in rexchat (over ACP) or as its own CLI.
HARNESSES = ("rexchat", "native")
REXCHAT_STATE = Path(os.environ.get("REXCHAT_STATE_DIR") or Path.home() / ".local/state/rexchat")
TICKET_RE = re.compile(r"^([A-Za-z]+)-(\d+)$")
# A Rex session id without its `session:` prefix, such as 01a1fabd-f4aa-...
SESSION_UUID_RE = re.compile(r"^[0-9a-fA-F-]{8,64}$")
BLOCK_RE = re.compile(r"^block:[0-9a-fA-F-]{8,64}$")
# An authorization from `rexwork promote` is good for this long.
AUTH_TTL = 12 * 3600
# Rex names new sessions with two lowercase words, such as dawn-grotto.
GENERATED_RE = re.compile(r"^[a-z]+-[a-z]+$")


class Failure(Exception):
    pass


def fail(message):
    raise Failure(message)


def note(message):
    print(f"rexwork: {message}", file=sys.stderr)


def emit(data):
    print(json.dumps(data, indent=2))
    sys.stdout.flush()


# ---- names ------------------------------------------------------------------

def normalize_ticket(text):
    """'tal-12' or '12' -> 'TAL-12'. Returns None for anything else."""
    text = (text or "").strip()
    if text.isdigit():
        return f"{TEAM}-{int(text)}"
    m = TICKET_RE.match(text)
    return f"{m.group(1).upper()}-{int(m.group(2))}" if m else None


def ticket_of_label(label):
    first = (label or "").split(" ", 1)[0]
    return normalize_ticket(first) if TICKET_RE.match(first) else None


def label_matches_ticket(label, ticket):
    """'TAL-1 Fix' matches TAL-1; 'TAL-10 Fix' does not."""
    return ticket_of_label(label) == ticket


def branch_matches_ticket(branch, ticket):
    """u/tfriedman/tal-1 and u/tfriedman/tal-1-fix match TAL-1; u/tfriedman/tal-10-fix does not."""
    if not branch or not ticket:
        return False
    prefix = BRANCH_PREFIX + ticket.lower()
    return branch == prefix or branch.startswith(prefix + "-")


def check_name(name, what="name"):
    """A label or tab name that Rex will not read as an option."""
    name = re.sub(r"\s+", " ", name or "").strip()
    if not name:
        fail(f"give a {what}")
    if name.startswith("-"):
        fail(f"{what} must not start with '-': {name!r}")
    return name


# Fields that belong to one ticket; dropped when a session's ticket changes.
TICKET_FIELDS = ("title", "url", "repo", "worktree", "branch", "pr_url", "landed_at", "filing",
                 "worktree_created", "worktree_provider", "lease_id", "worktree_at", "pending", "worktree_error")


def ticket_change(state, ticket):
    """Updates that clear the old ticket's fields when the session's ticket changes."""
    old = state.get("ticket")
    if old and old != ticket:
        return {k: None for k in TICKET_FIELDS}
    return {}


def short_name(title, max_len=32, max_words=5):
    """The first words of a title, for a session label."""
    text = re.sub(r"^(\s*\[[^\]]*\]\s*)+", "", title or "").strip()
    words, length = [], 0
    for word in text.split():
        if words and (length + 1 + len(word) > max_len or len(words) >= max_words):
            break
        words.append(word)
        length += len(word) + (1 if len(words) > 1 else 0)
    return " ".join(words).rstrip(":;,.-–—/ ")


def slugify(text, max_len=40):
    slug = re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")
    if len(slug) > max_len:
        cut = slug[:max_len]
        slug = cut.rsplit("-", 1)[0] if "-" in cut else cut
    return slug


def ticket_label(ticket, title):
    name = short_name(title)
    return f"{ticket} {name}" if name else ticket


def branch_name(ticket, title):
    slug = slugify(short_name(title))
    return BRANCH_PREFIX + ticket.lower() + (f"-{slug}" if slug else "")


def is_generated_label(label):
    return bool(GENERATED_RE.match(label or ""))


def parse_draft(text):
    """'# Title' on the first non-empty line, the description after it."""
    text = re.sub(r"<!--.*?-->\n?", "", text, flags=re.S)
    lines = text.splitlines()
    while lines and not lines[0].strip():
        lines.pop(0)
    if not lines or not re.match(r"^#\s+\S", lines[0]):
        raise ValueError("the draft must start with '# Title' on its first line")
    title = re.sub(r"^#\s+", "", lines[0]).strip()
    if title.lower() in ("title", "<title>"):
        raise ValueError("the draft still has the template's title")
    description = "\n".join(lines[1:]).strip("\n")
    if not description.strip():
        raise ValueError("the draft has no description below the title")
    return title, description.rstrip() + "\n"


def merge_state(old, updates):
    """Keep every key not being updated; a value of None removes the key."""
    merged = dict(old)
    for key, value in updates.items():
        if value is None:
            merged.pop(key, None)
        else:
            merged[key] = value
    return merged


def objectives_skeleton(label, ticket=None, url=None):
    head = f"# Objectives: {label}\n\n"
    if ticket:
        head += f"Ticket: {ticket}" + (f" ({url})" if url else "") + "\n\n"
    return head + ("Nested goals, each a few words with a status: todo, doing, done, blocked.\n\n"
                   "- todo: (main goal)\n"
                   "  - todo: (first step)\n")


def draft_template(objectives):
    return ("# Title: what this ticket delivers, in a few words\n\n"
            "One or two short paragraphs: the goal and why it matters.\n\n"
            "## Done when\n\n- ...\n\n"
            "## Notes\n\n- Constraints, decisions already made, links.\n\n"
            "+++ Agent notes\n\nDetail for agents: files, commands, evidence.\n\n+++\n\n"
            "<!-- Objectives at the time of drafting (this comment is not filed):\n\n"
            + (objectives.strip() or "(none yet)").replace("-->", "- ->") + "\n-->\n")


# ---- state ------------------------------------------------------------------

def uuid_of(session):
    """The session id without `session:`. Fails for anything but a plain Rex id, so a
    crafted --session (an absolute path, `..`) never names a directory."""
    text = (session or "").strip()
    text = text[len("session:"):] if text.startswith("session:") else text
    if not SESSION_UUID_RE.match(text):
        fail(f"not a Rex session id: {session!r}")
    return text


def session_id(text):
    return "session:" + uuid_of(text)


def is_session_id(text):
    try:
        uuid_of(text)
    except Failure:
        return False
    return True


def check_state_dir(directory):
    """Fails unless DIRECTORY is a direct child of SESSIONS with its own name after resolving
    links (a link from id A to sibling B is refused, as `show` does)."""
    directory = Path(directory)
    resolved = directory.resolve()
    if (not SESSION_UUID_RE.match(directory.name) or resolved.parent != SESSIONS.resolve()
            or resolved.name != directory.name):
        fail(f"{directory} is not a rexwork session directory under {SESSIONS}")
    return directory


def state_dir(session):
    return check_state_dir(SESSIONS / uuid_of(session))


def read_state(directory):
    try:
        data = json.loads((directory / "session.json").read_text())
    except FileNotFoundError:
        return {}
    except ValueError:
        fail(f"{directory / 'session.json'} is not valid JSON; not touching it")
    if not isinstance(data, dict):
        fail(f"{directory / 'session.json'} is not a JSON object; not touching it")
    return data


_LOCAL = threading.local()


@contextlib.contextmanager
def session_lock(directory):
    """The session's lock; re-entrant within one thread."""
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    key = str(directory.resolve())
    held = _LOCAL.__dict__.setdefault("held", set())
    if key in held:
        yield
        return
    with open(directory / ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        held.add(key)
        try:
            yield
        finally:
            held.discard(key)


def update_state(directory, **updates):
    with session_lock(directory):
        data = merge_state(read_state(directory), updates)
        tmp = directory / f"session.json.{os.getpid()}.tmp"
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        tmp.replace(directory / "session.json")
    return data


def write_objectives(directory, label, ticket=None, url=None):
    path = directory / "objectives.md"
    if not path.exists():
        path.write_text(objectives_skeleton(label, ticket, url))
    return path


# ---- processes --------------------------------------------------------------

def run(args, cwd=None, timeout=60, input_text=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, cwd=cwd,
                              input=input_text, stdin=None if input_text is not None else subprocess.DEVNULL)
    except FileNotFoundError:
        fail(f"{args[0]}: not found")
    except subprocess.TimeoutExpired:
        fail(f"{' '.join(args[:3])}: timed out after {timeout}s")


def rex(*args, timeout=30):
    out = run(["rex", *args], timeout=timeout)
    if out.returncode != 0:
        fail(f"rex {' '.join(args[:3])}: {out.stderr.strip()}")
    text = out.stdout.strip()
    if not text:
        return {}
    try:
        return json.loads(text)
    except ValueError:
        return {"output": text}


def rex_sessions():
    out = rex("ls", "--json")
    return out.get("sessions", []) if isinstance(out, dict) else out


def live_sessions():
    return {s["session_id"]: s for s in rex_sessions() if s.get("session_id")}


def inspect(session):
    return rex("session", "inspect", session, "--json")


def tiled_blocks(window):
    for layer in window.get("layers", []):
        if layer.get("kind") == "tiled":
            yield from layer.get("blocks", [])


def window_of(view, block):
    for window in view.get("windows", []):
        for layer in window.get("layers", []):
            if any(b.get("block_id") == block for b in layer.get("blocks", [])):
                return window
    return None


def git(*args, cwd=None, check=True, timeout=60):
    out = run(["git", *args], cwd=cwd, timeout=timeout)
    if check and out.returncode != 0:
        fail(f"git {' '.join(args)}: {out.stderr.strip()}")
    return out.stdout.strip() if out.returncode == 0 else None


# ---- Linear -----------------------------------------------------------------

def linear(query, variables=None):
    key_file = Path(os.environ.get("LINEAR_KEY_FILE", Path.home() / ".linear_key"))
    try:
        key = key_file.read_text().strip()
    except OSError:
        fail(f"no Linear key at {key_file}")
    request = urllib.request.Request(
        LINEAR_API, data=json.dumps({"query": query, "variables": variables or {}}).encode(),
        headers={"Content-Type": "application/json", "Authorization": key})
    try:
        with urllib.request.urlopen(request, timeout=30) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        fail(f"Linear: HTTP {e.code}: {e.read().decode(errors='replace')[:300]}")
    except (urllib.error.URLError, TimeoutError) as e:
        fail(f"Linear: {e}")
    if data.get("errors"):
        fail(f"Linear: {data['errors'][0].get('message', data['errors'])}")
    return data["data"]


def get_issue(ticket):
    q = ("query($id:String!){issue(id:$id){id identifier title url "
         "state{id name type} team{id key}}}")
    issue = linear(q, {"id": ticket}).get("issue")
    if not issue:
        fail(f"no Linear issue {ticket}")
    return issue


def team_info(key=TEAM):
    q = ("query($key:String!){viewer{id name} teams(filter:{key:{eq:$key}})"
         "{nodes{id key states{nodes{id name type}}}}}")
    data = linear(q, {"key": key})
    teams = data["teams"]["nodes"]
    if not teams:
        fail(f"no Linear team {key}")
    team = teams[0]
    states = {s["name"]: s for s in team["states"]["nodes"]}
    return {"team_id": team["id"], "states": states, "viewer": data["viewer"]}


def state_id(info, name):
    state = info["states"].get(name)
    if not state:
        fail(f"team {TEAM} has no state {name!r}")
    return state["id"]


def set_issue_state(issue, name, info=None):
    info = info or team_info(issue["team"]["key"])
    m = "mutation($id:String!,$s:String!){issueUpdate(id:$id,input:{stateId:$s}){success}}"
    if not linear(m, {"id": issue["id"], "s": state_id(info, name)})["issueUpdate"]["success"]:
        fail(f"Linear: could not move {issue['identifier']} to {name}")


def comment_issue(issue, body):
    m = "mutation($i:String!,$b:String!){commentCreate(input:{issueId:$i,body:$b}){success}}"
    if not linear(m, {"i": issue["id"], "b": body})["commentCreate"]["success"]:
        fail(f"Linear: could not comment on {issue['identifier']}")


def build_issue_input(title, description):
    """Everything up to the write: read-only lookups, then the issueCreate input."""
    info = team_info()
    payload = {"teamId": info["team_id"], "title": title, "description": description,
               "assigneeId": info["viewer"]["id"], "stateId": state_id(info, "In Progress")}
    # No labelIds: an `agent` label would hand the ticket to Symphony.
    assert "labelIds" not in payload
    return payload, info


def create_issue(payload):
    m = ("mutation($input:IssueCreateInput!){issueCreate(input:$input)"
         "{success issue{id identifier title url state{name} team{key}}}}")
    result = linear(m, {"input": payload})["issueCreate"]
    if not result["success"] or not result.get("issue"):
        fail("Linear: issueCreate failed")
    return result["issue"]


ISSUE_FIELDS = "id identifier title url createdAt state{name} team{key}"


def find_filed_issue(filing):
    """Read-only: the issue an earlier filing attempt created, or None. Looks it up only by
    the client-chosen id the attempt sent as issueCreate's `id`; never by title, so an
    issue Tal made by hand with the same title is never adopted."""
    if not filing.get("issue_uuid"):
        fail("the interrupted filing has no recorded issue id, so it can not be matched in Linear; "
             "check Linear by hand, then run `rexwork promote --clear-filing` in a terminal")
    try:
        issue = linear("query($id:String!){issue(id:$id){%s}}" % ISSUE_FIELDS,
                       {"id": filing["issue_uuid"]}).get("issue")
    except Failure as e:
        if "not found" not in str(e).lower():
            raise
        return None
    if issue and issue.get("id") != filing["issue_uuid"]:
        return None
    return issue


# ---- git worktrees ----------------------------------------------------------

def repo_root(path):
    top = git("rev-parse", "--show-toplevel", cwd=path, check=False)
    if not top:
        fail(f"not a git repository: {path}")
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=top)
    main = Path(common)
    main = main.parent if main.name == ".git" else main
    return Path(top).resolve(), main.resolve()


def worktrees(repo):
    rows, row = [], {}
    for line in (git("worktree", "list", "--porcelain", cwd=repo) or "").splitlines() + [""]:
        if not line:
            if row:
                rows.append(row)
            row = {}
        elif " " in line:
            k, v = line.split(" ", 1)
            row[k] = v
        else:
            row[line] = True
    return rows


def default_base(repo):
    head = git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD", cwd=repo, check=False)
    for ref in [head, "origin/main", "origin/master", "main", "master", "HEAD"]:
        if ref and git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", cwd=repo, check=False):
            return ref
    fail(f"{repo}: no commit to branch from")


def plan_worktree(repo_path, ticket, title):
    """Where the ticket's worktree is or would be. Reuses an existing branch for the ticket."""
    _, main = repo_root(repo_path)
    branches = (git("for-each-ref", "--format=%(refname:short)", f"refs/heads/{BRANCH_PREFIX}", cwd=main,
                    check=False) or "").splitlines()
    existing = [b for b in branches if branch_matches_ticket(b, ticket)]
    branch = existing[0] if existing else branch_name(ticket, title)
    for row in worktrees(main):
        if row.get("branch") == f"refs/heads/{branch}":
            return {"repo": str(main), "branch": branch, "worktree": row["worktree"], "action": "reuse"}
    path = WORKTREES / f"{main.name}-{ticket.lower()}"
    action = "add existing branch" if existing else "create branch"
    if not existing and git("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}", cwd=main,
                            check=False):
        action = "track remote branch"
    return {"repo": str(main), "branch": branch, "worktree": str(path), "action": action}


class WorktreeIncomplete(Failure):
    """A worktree step failed after something was acquired (a treehouse lease). `tree`
    holds what exists, so it is recorded and a retry reuses it instead of leasing again."""

    def __init__(self, message, tree):
        super().__init__(message)
        self.tree = tree


# Providers rexwork created the worktree with, so `release` may remove it. A worktree
# rexwork found (Tal's own, another agent's) is "adopted" and never removed.
OWNED_PROVIDERS = ("git", "treehouse")
TREEHOUSE_TIMEOUT = 900  # `treehouse get` warms a cold slot; that can take minutes


def config_paths():
    """$XDG_CONFIG_HOME/rexwork/config.json, then ~/.config/rexwork/config.json (Rex runs
    actions without XDG_CONFIG_HOME). $REXWORK_CONFIG replaces both (tests)."""
    if os.environ.get("REXWORK_CONFIG"):
        return [Path(os.environ["REXWORK_CONFIG"])]
    paths = []
    if os.environ.get("XDG_CONFIG_HOME"):
        paths.append(Path(os.environ["XDG_CONFIG_HOME"]) / "rexwork" / "config.json")
    paths.append(Path.home() / ".config" / "rexwork" / "config.json")
    return paths


def load_config():
    for path in config_paths():
        try:
            data = json.loads(path.read_text())
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as e:
            fail(f"{path}: {e}")
        if not isinstance(data, dict) or not isinstance(data.get("repos", {}), dict):
            fail(f"{path}: expected {{\"repos\": {{\"/path/to/repo\": {{\"worktrees\": \"treehouse\"}}}}}}")
        return data
    return {}


def repo_config(main, top=None):
    """The config entry for a repo, matched by its main checkout or its top level."""
    wanted = {str(Path(main).resolve())} | ({str(Path(top).resolve())} if top else set())
    for key, value in (load_config().get("repos") or {}).items():
        if str(Path(key).expanduser().resolve()) in wanted:
            return value if isinstance(value, dict) else {}
    return {}


def worktree_provider(main, top=None):
    provider = repo_config(main, top).get("worktrees", "git")
    if provider not in OWNED_PROVIDERS:
        fail(f"rexwork config: worktrees for {main} must be \"git\" or \"treehouse\", not {provider!r}")
    return provider


def lease_holder(ticket):
    return f"rexwork:{ticket}"


def treehouse(*args, cwd, timeout=60):
    prog = os.environ.get("REXWORK_TREEHOUSE") or shutil.which("treehouse") or str(Path.home() / ".local/bin/treehouse")
    try:
        out = run([prog, *args], cwd=cwd, timeout=timeout)
    except Failure as e:
        fail(f"treehouse {' '.join(args[:2])}: {e}")
    if out.returncode != 0:
        fail(f"treehouse {' '.join(args[:2])}: {(out.stderr or out.stdout).strip()}")
    return out.stdout


def treehouse_status(repo):
    try:
        rows = json.loads(treehouse("status", "--json", cwd=repo) or "[]")
    except ValueError:
        fail("treehouse status --json printed no JSON")
    return [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else []


def held_leases(repo, ticket):
    """Slots of REPO's pool leased by rexwork for TICKET (never anyone else's)."""
    return [r for r in treehouse_status(repo) if r.get("lease_holder") == lease_holder(ticket) and r.get("lease_id")]


def same_path(a, b):
    return bool(a and b) and str(Path(a).resolve()) == str(Path(b).resolve())


class WorktreeBlocked(Failure):
    """A worktree path that belongs to someone else (a treehouse slot another holder
    leased). Nothing runs there and nothing touches it."""

    def __init__(self, message, path):
        super().__init__(message)
        self.path = path


def treehouse_root():
    return Path(os.environ.get("REXWORK_TREEHOUSE_ROOT") or Path.home() / ".treehouse")


def in_treehouse_root(path):
    try:
        Path(path).resolve().relative_to(treehouse_root().resolve())
        return True
    except ValueError:
        return False


def pool_row(main, path, provider):
    """The treehouse pool row for PATH, or None when PATH is not a pool slot. Asks
    treehouse for opted-in repos and for any path under the treehouse root."""
    if provider != "treehouse" and not in_treehouse_root(path):
        return None
    try:
        rows = treehouse_status(main)
    except Failure as e:
        if in_treehouse_root(path):
            raise WorktreeBlocked(f"{path} looks like a treehouse slot and its lease can not be checked ({e}); "
                                  "not using it", path) from None
        raise
    row = next((r for r in rows if same_path(r.get("path"), path)), None)
    if row is None and in_treehouse_root(path):
        return {"path": str(path), "lease_holder": "", "lease_id": ""}  # a slot treehouse did not list
    return row


def check_slot(main, path, ticket, provider, lease_id=None):
    """None if PATH is not a pool slot; the row if rexwork holds it for TICKET (with
    LEASE_ID when one is recorded). Any other slot raises WorktreeBlocked."""
    row = pool_row(main, path, provider)
    if row is None:
        return None
    holder, current = row.get("lease_holder") or "", row.get("lease_id") or ""
    if holder != lease_holder(ticket) or not current or (lease_id and current != lease_id):
        who = f"leased by {holder!r} (lease {current})" if current else "not leased by rexwork"
        raise WorktreeBlocked(f"{path} is a treehouse slot {who}, not by {lease_holder(ticket)}"
                              + (f" with lease {lease_id}" if lease_id else "")
                              + "; rexwork leaves it alone and starts nothing there", path)
    return row


def git_identity(path, branch):
    """What makes a git worktree this one: its path, main repo, branch, and the git dir
    (path and inode) git made for it."""
    gitdir = git("rev-parse", "--absolute-git-dir", cwd=path)
    _, main = repo_root(path)
    return {"path": str(Path(path).resolve()), "repo": str(main), "branch": branch, "gitdir": gitdir,
            "gitdir_ino": os.stat(gitdir).st_ino}


def identity_problem(record):
    """None if the live worktree at the record's path is still the one rexwork created;
    else what differs."""
    path = record.get("path")
    if not path or not Path(path).is_dir():
        return f"{path} is gone"
    try:
        now = git_identity(path, git("symbolic-ref", "-q", "--short", "HEAD", cwd=path, check=False))
    except (Failure, OSError) as e:
        return f"{path} is not a readable git worktree ({e})"
    for key in ("repo", "gitdir", "gitdir_ino", "branch"):
        if now.get(key) != record.get(key):
            return (f"{path} is not the worktree rexwork created ({key} is {now.get(key)!r}, "
                    f"recorded {record.get(key)!r})")
    return None


def created_record(provider, path, main, branch, lease_id=None):
    """`worktree_created`: written only when rexwork itself made the worktree (or holds its
    lease). Without it a worktree is adopted, and `release` never removes it."""
    if provider == "git":
        record = git_identity(path, branch)
    else:
        record = {"path": str(Path(path).resolve()), "repo": str(main), "branch": branch, "lease_id": lease_id}
    return {**record, "provider": provider, "at": int(time.time())}


def prior_record(ticket, path):
    """A git `worktree_created` record for PATH in a session dir of TICKET whose worktree is
    still that same checkout, or None."""
    for state_file in sorted(SESSIONS.glob("*/session.json")) if SESSIONS.exists() else []:
        try:
            data = json.loads(state_file.read_text())
        except (OSError, ValueError):
            continue
        record = data.get("worktree_created") if isinstance(data, dict) else None
        if (isinstance(record, dict) and data.get("ticket") == ticket and same_path(record.get("path"), path)
                and record.get("provider") == "git" and not identity_problem(record)):
            return record
    return None


def tree_of(main, branch, path, action, provider, lease_id=None, created=None):
    return {"repo": str(main), "branch": branch, "worktree": str(path), "action": action,
            "worktree_provider": provider, "lease_id": lease_id, "worktree_at": int(time.time()),
            "worktree_created": created}


def found_worktree(main, path, branch, ticket, provider, action):
    """A worktree rexwork did not just create: a pool slot must be rexwork's lease for
    TICKET (else WorktreeBlocked); a git worktree is owned only by an earlier creation
    record that still matches, else adopted."""
    row = check_slot(main, path, ticket, provider)
    if row:
        return tree_of(main, branch, path, action, "treehouse", row["lease_id"],
                       created_record("treehouse", path, main, branch, row["lease_id"]))
    prior = prior_record(ticket, path)
    if prior:
        return tree_of(main, branch, path, action, "git", None, prior)
    return tree_of(main, branch, path, action, "adopted")


def checkout_ticket_branch(path, plan):
    """Put the leased slot at PATH on the ticket's branch. A fresh slot is detached at the
    pool's base; an existing branch is checked out, a remote one tracked, else created."""
    branch, main = plan["branch"], plan["repo"]
    if git("symbolic-ref", "-q", "--short", "HEAD", cwd=path, check=False) == branch:
        return
    if git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=main, check=False):
        git("checkout", "-q", branch, cwd=path)
    elif git("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}", cwd=main, check=False):
        git("checkout", "-q", "--track", "-b", branch, f"origin/{branch}", cwd=path)
    else:
        git("checkout", "-q", "-b", branch, cwd=path)


def treehouse_worktree(plan, ticket):
    """Lease a slot for TICKET (or reuse the one rexwork already holds for it) and put it on
    the ticket's branch. Never leases twice; never falls back to plain git."""
    main, branch = plan["repo"], plan["branch"]
    mine = held_leases(main, ticket)
    if len(mine) > 1:
        fail(f"treehouse has {len(mine)} slots leased by {lease_holder(ticket)} "
             f"({', '.join(r.get('path', '?') for r in mine)}); return the extra ones by hand")
    if mine:
        path, lease_id, action = mine[0]["path"], mine[0]["lease_id"], "reuse lease"
    else:
        args = ["get", "--lease", "--json", "--lease-holder", lease_holder(ticket)]
        if plan["action"] == "create branch":
            args += ["-b", branch]
        try:
            out = treehouse(*args, cwd=main, timeout=TREEHOUSE_TIMEOUT)
        except Failure as e:
            if "timed out" in str(e):
                fail(f"{e}. The slot may still be warming: check `treehouse status` in {main}, then run "
                     f"the same command again; it reuses a slot leased by {lease_holder(ticket)}")
            raise
        try:
            data = json.loads(out)
        except ValueError:
            data = {"path": out.strip().splitlines()[-1] if out.strip() else None}
        path, lease_id = data.get("path"), data.get("lease_id")
        if not path:
            fail(f"treehouse get printed no path: {out.strip()[:200]!r}")
        if not lease_id:
            lease_id = next((r.get("lease_id") for r in treehouse_status(main) if same_path(r.get("path"), path)), None)
        action = "lease"
    tree = tree_of(main, branch, path, action, "treehouse", lease_id,
                   created_record("treehouse", path, main, branch, lease_id))
    try:
        checkout_ticket_branch(path, plan)
    except Failure as e:
        raise WorktreeIncomplete(f"leased {path} (lease {lease_id}) but could not check out {branch}: {e}; "
                                 "the lease is recorded and kept, and a retry reuses it", tree) from None
    return tree


def ensure_worktree(repo_path, ticket, title, state=None):
    """The ticket's worktree: the live one recorded in STATE (a pool slot only while
    rexwork still holds its recorded lease), else (treehouse) the slot rexwork leased for
    the ticket, else any worktree already on the ticket's branch (never someone else's
    pool slot), else a new one from the repo's provider."""
    state = state or {}
    recorded = state.get("worktree")
    if (recorded and Path(recorded).is_dir() and branch_matches_ticket(state.get("branch"), ticket)
            and git("symbolic-ref", "-q", "--short", "HEAD", cwd=recorded, check=False) == state["branch"]):
        main = state.get("repo") or str(repo_root(recorded)[1])
        provider = state.get("worktree_provider")
        # A pool slot is reused only while rexwork holds its recorded lease (else WorktreeBlocked).
        check_slot(main, recorded, ticket, provider or "git", state.get("lease_id"))
        return {"repo": main, "branch": state["branch"], "worktree": recorded, "action": "reuse",
                "worktree_provider": provider, "lease_id": state.get("lease_id"),
                "worktree_at": state.get("worktree_at"), "worktree_created": state.get("worktree_created")}
    top, main = repo_root(repo_path)
    provider = worktree_provider(main, top)
    plan = plan_worktree(repo_path, ticket, title)
    if provider == "treehouse" and held_leases(main, ticket):
        return treehouse_worktree(plan, ticket)
    if plan["action"] == "reuse":
        return found_worktree(main, plan["worktree"], plan["branch"], ticket, provider, "reuse")
    if provider == "treehouse":
        return treehouse_worktree(plan, ticket)
    branch, path = plan["branch"], Path(plan["worktree"])
    if path.exists():
        fail(f"{path} exists and is not the worktree of {branch}; move it or pass another --repo")
    path.parent.mkdir(parents=True, exist_ok=True)
    if plan["action"] == "add existing branch":
        git("worktree", "add", str(path), branch, cwd=main)
    elif plan["action"] == "track remote branch":
        git("worktree", "add", "--track", "-b", branch, str(path), f"origin/{branch}", cwd=main)
    else:
        git("worktree", "add", "--no-track", "-b", branch, str(path), default_base(main), cwd=main)
    return tree_of(main, branch, path, plan["action"], "git", None, created_record("git", path, main, branch))


TREE_KEYS = ("repo", "worktree", "branch", "worktree_provider", "lease_id", "worktree_at", "worktree_created")


def tree_fields(tree):
    """session.json fields for a worktree from ensure_worktree."""
    return {k: tree.get(k) for k in TREE_KEYS}


def default_repo(args, base):
    """--repo, else (default on) the git repo BASE is in. None with --no-worktree, for
    Symphony's sessions (Symphony owns its workspace) and outside a git repo."""
    if args.repo:
        return str(Path(args.repo).expanduser().resolve())
    if getattr(args, "no_worktree", False) or getattr(args, "owner", None) == "symphony":
        return None
    if base and Path(base).is_dir() and git("rev-parse", "--show-toplevel", cwd=base, check=False):
        return str(Path(base).resolve())
    return None


def worktree_for_start(repo, ticket, title):
    """(tree, pending, error, blocked_path) for `start`: a failure is recorded as pending,
    not fatal, so the session still starts and a retry finishes it. The caller's directory,
    when it is already a worktree on the ticket's branch, is adopted as it is, unless it is
    a pool slot someone else holds."""
    try:
        info = git_branch_info(repo)
        if branch_matches_ticket(info.get("branch"), ticket):
            top, main = repo_root(repo)
            return (found_worktree(main, top, info["branch"], ticket, worktree_provider(main, top), "adopt"),
                    [], None, None)
        return ensure_worktree(repo, ticket, title), [], None, None
    except WorktreeIncomplete as e:
        return e.tree, ["worktree"], str(e), None
    except WorktreeBlocked as e:
        return {}, ["worktree"], str(e), e.path
    except Failure as e:
        return {}, ["worktree"], str(e), None


