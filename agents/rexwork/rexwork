            "ticket": state.get("ticket"), "title": state.get("title"), "url": state.get("url"),
            "window_id": state.get("window_id"), "main_block": state.get("main_block"),
            "show_block": state.get("show_block"), "bar_block": state.get("bar_block"), "state_dir": str(directory),
            "repo": state.get("repo"), "worktree": state.get("worktree"), "branch": state.get("branch"),
            "worktree_provider": state.get("worktree_provider"), "lease_id": state.get("lease_id"),
            "agent": state.get("agent"), "harness": state.get("harness")}


def cmd_start(args):
    picked = [x for x in (args.scratch, args.draft, args.ticket) if x]
    if args.model and (args.command or args.no_agent):
        fail("--model needs an agent; it does not apply to -- COMMAND or --no-agent")
    if args.ask:
        return start_ask(args)
    if len(picked) != 1:
        fail("give exactly one of --scratch NAME, --draft NAME, or a ticket id")
    if args.ticket:
        return start_ticket(args)
    if args.repo:
        fail("--repo is only for ticketed sessions; a scratch or draft session never gets a worktree")
    return start_named(args, "scratch" if args.scratch else "draft")


