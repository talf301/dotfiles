def start_ask(args):
    """Terminal fallback for the picker: ask on the tty, then start."""
    print("Start work\n  1) Scratch session\n  2) Draft a ticket with an agent")
    choice = input("Choose 1 or 2: ").strip()
    if choice not in ("1", "2"):
        print("Cancelled.")
        return
    name = input("Short name: ").strip()
    if not name:
        print("Cancelled.")
        return
    if not args.agent and not args.no_agent:
        answer = input(f"Agent ({'/'.join(AGENTS)}, default claude): ").strip().lower()
        if answer and answer not in AGENTS:
            print(f"Unknown agent {answer!r}. Cancelled.")
            return
        args.agent = answer or "claude"
    if choice == "1":
        args.scratch = name
    else:
        args.draft = name
    start_named(args, "scratch" if choice == "1" else "draft")


