def caller(args, need_block=False):
    session = args.session or os.environ.get("REX_SESSION")
    if not session:
        fail("not in Rex: pass --session")
    session = session_id(session)
    block = getattr(args, "block", None) or os.environ.get("REX_BLOCK")
    if block and not block.startswith("block:"):
        block = "block:" + block
    if block and not BLOCK_RE.match(block):
        fail(f"not a Rex block id: {block!r}")
    if need_block and not block:
        fail("not in a Rex pane: pass --block")
    return session, block


def git_branch_info(path):
    top = git("rev-parse", "--show-toplevel", cwd=path, check=False)
    if not top:
        return {}
    branch = git("symbolic-ref", "-q", "--short", "HEAD", cwd=top, check=False)
    _, main = repo_root(top)
    return {"repo": str(main), "worktree": top, "branch": branch}


def rexchat_agent(block):
    """None unless a rexchat runs in BLOCK (its status file in rexchat's state directory);
    then the agent it runs, claude or codex, or "" if its name says neither."""
    try:
        data = json.loads((REXCHAT_STATE / f"{block.removeprefix('block:')}.json").read_text())
    except (OSError, ValueError):
        return None
    name = str(data.get("agent") or "").lower() if isinstance(data, dict) else ""
    return next((a for a in AGENTS if a in name), "")


def cmd_adopt(args):
    session, block = caller(args, need_block=True)
    view = inspect(session)
    window = window_of(view, block)
    if not window:
        fail(f"{block} is not in a tab of {session}")
    directory = state_dir(session)
    state = read_state(directory)
    current = label = view.get("label") or ""
    if args.name:
        label = check_name(args.name)
    elif is_generated_label(label) and not state.get("label"):
        fail(f"session still has a generated name ({label}); pass --name NAME")
    ticket = ticket_of_label(label)
    stale = ticket_change(state, ticket)
    if stale and held_worktree(state):
        fail(f"this session holds {state['worktree']} ({state['worktree_provider']}) for {state.get('ticket')}; "
             "run `rexwork release` before changing its ticket")
    if stale:
        note(f"ticket changed from {state.get('ticket')} to {ticket or 'none'}; "
             "dropped the old ticket's title, url, repo, worktree and branch")
    updates = {**stale, "session_id": session, "window_id": window["window_id"], "main_block": block,
               "label": label, "kind": "ticketed" if ticket else state.get("kind", "scratch"), "ticket": ticket}
    if ticket and (stale or not state.get("title")):
        if args.title:
            updates["title"] = args.title
        else:
            try:
                issue = get_issue(ticket)
                updates.update(title=issue["title"], url=issue["url"])
            except Failure as e:
                note(f"no title for {ticket}: {e}")
    if ticket:
        info = git_branch_info(args.repo or caller_cwd())
        if branch_matches_ticket(info.get("branch"), ticket):
            updates.update(info)
            if not same_path(info["worktree"], state.get("worktree")) or not state.get("worktree_provider"):
                try:
                    found = found_worktree(info["repo"], info["worktree"], info["branch"], ticket,
                                           worktree_provider(info["repo"], info["worktree"]), "adopt")
                except Failure as e:  # someone else's slot, or unreadable: never released by rexwork
                    note(f"recording {info['worktree']} as adopted: {e}")
                    found = tree_of(info["repo"], info["branch"], info["worktree"], "adopt", "adopted")
                updates.update(worktree_provider=found["worktree_provider"], lease_id=found["lease_id"],
                               worktree_created=found["worktree_created"],
                               worktree_at=state.get("worktree_at") or int(time.time()))
        elif args.repo:
            fail(f"{args.repo} is on branch {info.get('branch')!r}, which is not a {ticket} branch "
                 f"({BRANCH_PREFIX}{ticket.lower()} or {BRANCH_PREFIX}{ticket.lower()}-...)")
    if not state.get("created_at"):
        updates["created_at"] = int(time.time())
    found = rexchat_agent(block)  # a rexchat runs in the pane: the agent's process is rexchat, not claude/codex
    harness = args.harness or ("rexchat" if found is not None else None)
    if harness:
        updates["harness"] = harness
    if args.agent or found:
        updates["agent"] = args.agent or found
    if label != current:  # rename only after every check passed
        rex("session", "rename", session, label)
    show = open_show(session, block) if args.show else {}
    updates["show_block"] = show.get("pane") or (state.get("show_block") if window_of(view, state.get("show_block"))
                                                 else None)
    warnings = []
    updates["bar_block"] = bar_pane(warnings, args, session, window["window_id"]) or state.get("bar_block")
    state = update_state(directory, **updates)
    write_objectives(directory, label, ticket, state.get("url"))
    emit({**result_of(session, state, directory), "show_created": show.get("created_pane", False),
          "warnings": warnings})


