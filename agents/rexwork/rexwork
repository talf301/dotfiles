#!/usr/bin/env python3
"""rexwork: start, promote and land a Rex session as one unit of work.

  rexwork start --scratch NAME | --draft NAME | TAL-123 [options]
  rexwork adopt [--name NAME]
  rexwork promote [--template | --file | --recover | --clear-filing] [--draft FILE] [--repo PATH] [--dry-run]
  rexwork land [--yes [--expect DIGEST]] [--keep] [--dry-run [--json]] [--no-pr] [--no-linear] [--linear-only]
  rexwork release [TAL-123] [--yes] [--dry-run] [--force]
  rexwork status [--json]
  rexwork ls [--json]

State lives in ~/.local/state/rexwork/sessions/<uuid>/. See README.md.
"""
