def cmd_status(args):
    session, _ = caller(args)
    directory = state_dir(session)
    state = read_state(directory)
    live = live_sessions()
    data = {**state, "state_dir": str(directory), "alive": session in live,
            "rex_label": (live.get(session) or {}).get("label")}
    if args.json:
        emit(data)
        return
    if not state:
        print(f"No rexwork state for {session}. Run `rexwork adopt` to add it.")
        return
    print(f"{state.get('label')}  ({state.get('kind')})")
    for key in ("ticket", "title", "url", "branch", "worktree", "worktree_provider", "lease_id", "agent", "harness",
                "model", "pr_url",
                "pending", "worktree_error"):
        if state.get(key):
            print(f"  {key}: {state[key]}")
    print(f"  state: {directory}")
    if not data["alive"]:
        print("  the Rex session no longer exists")


def cmd_ls(args):
    live = live_sessions()
    rows = []
    for directory in sorted(SESSIONS.glob("*")) if SESSIONS.exists() else []:
        if not directory.is_dir() or not is_session_id(directory.name):
            continue
        try:
            state = read_state(directory)
        except Failure:
            state = {"label": "(unreadable session.json)"}
        sid = session_id(directory.name)
        held = held_worktree(state)
        if held:
            held = {**held, "age": describe_age(held["since"])}
        rows.append({"session_id": sid, "label": state.get("label") or (live.get(sid) or {}).get("label"),
                     "kind": state.get("kind"), "ticket": state.get("ticket"), "harness": state.get("harness"),
                     "alive": sid in live, "state_dir": str(directory), "holds_worktree": held})
    if args.json:
        emit(rows)
        return
    for r in rows:
        print(f"{'live' if r['alive'] else 'gone':4}  {r['kind'] or '-':8}  {r['ticket'] or '-':8}  "
              f"{r['harness'] or '-':7}  {r['label'] or '-':40}  {r['session_id']}")
        held = r["holds_worktree"]
        if held:
            what = f"treehouse lease {held['lease_id']}" if held["provider"] == "treehouse" else "git worktree"
            print(f"      holds {what} at {held['worktree']} for {held['age']}; "
                  f"`rexwork release --session {r['session_id']}` once its PR is merged")


