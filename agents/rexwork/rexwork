def detect_repo(session, state):
    """The main repo of the session's directory (session.json cwd, else the main pane's), or None."""
    for path in (state.get("cwd"), pane_cwd(session, state.get("main_block"))):
        if path and Path(path).is_dir() and git("rev-parse", "--show-toplevel", cwd=path, check=False):
            try:
                return str(repo_root(path)[1])
            except Failure:
                continue
    return None


def branch_hint(repo):
    return (f"No branch will be attached. The session's directory is in {repo}: create a "
            f"{BRANCH_PREFIX}tal-<n>-... worktree there, then run `rexwork adopt --repo WORKTREE` "
            "from the agent pane to attach it.")


def preview_of(title, description, record):
    lines = description.rstrip("\n").splitlines()
    preview = {"title": title, "description_lines": len(lines), "description_chars": len(description),
               "description_head": lines[:4]}
    if record.get("repo"):
        preview["branch"] = f"a worktree and branch in {record['repo']}"
    elif record.get("detected_repo"):
        preview["branch"] = branch_hint(record["detected_repo"])
    else:
        preview["branch"] = "no repo: no branch will be attached"
    return preview


def post_filing_steps(filing):
    """What promotion does after issueCreate: relabel the session and tab, and with a repo,
    the worktree."""
    return ["label"] + (["worktree"] if filing.get("repo") else [])


def pending_steps(state):
    """Post-filing steps not yet done for a recorded ticket; [] when nothing is pending."""
    filing = state.get("filing") or {}
    if not filing.get("ticket") or filing.get("dry_run"):
        return []
    if "done" not in filing and state.get("kind") == "ticketed":
        return []  # recorded by an older rexwork, which finished in one go
    return [s for s in post_filing_steps(filing) if s not in filing.get("done", [])]


def interrupted_filing(state):
    """A real filing attempt that recorded no ticket (it failed or timed out), or None."""
    filing = state.get("filing")
    if isinstance(filing, dict) and not filing.get("dry_run") and not filing.get("ticket"):
        return filing
    return None


def pending_note(state):
    """One line about an unfinished earlier attempt, or None."""
    filing = interrupted_filing(state)
    if filing:
        return (f"an earlier filing attempt ({describe_when(filing)}, title {filing.get('title')!r}) recorded "
                f"no ticket; confirming looks up its issue id {filing.get('issue_uuid')} in Linear and adopts "
                "it if it exists. Nothing new is created.")
    steps = pending_steps(state)
    if steps:
        return (f"{state['filing']['ticket']} was filed but promotion did not finish ({', '.join(steps)}); "
                "run `rexwork promote --recover` to finish it")
    return None


def describe_when(filing):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(filing.get("at", 0)))


def cmd_promote(args):
    session, block = caller(args)
    directory, state = require_state(session)
    if args.clear_filing:
        return clear_filing(directory)
    if args.recover:
        return recover_promotion(args, session, directory)
    draft = directory / "ticket-draft.md"
    if args.template:
        objectives = directory / "objectives.md"
        sys.stdout.write(draft_template(objectives.read_text() if objectives.exists() else ""))
        return
    if args.preview:
        return preview_request(directory)
    if args.file:
        return file_ticket(args, session, directory, draft)
    if pending_steps(state):
        fail(pending_note(state))
    if state.get("kind") == "ticketed":
        fail(f"this session is already ticketed ({state.get('ticket')})")
    if args.draft:
        src = Path(args.draft).expanduser().resolve()
        if not src.is_file():
            fail(f"no such file: {src}")
        if src != draft.resolve():
            shutil.copyfile(src, draft)
    if not draft.exists():
        if args.request_draft:
            return request_draft(session, directory, state)
        fail(f"no draft at {draft}; write it first (`rexwork promote --template` prints the skeleton)")
    try:
        title, description = parse_draft(draft.read_text())
    except ValueError as e:
        fail(f"{draft}: {e}")
    payload, info = build_issue_input(title, description)
    detected = None if args.repo else detect_repo(session, state)
    # Default on: the session's repo gets the ticket's worktree, unless --no-worktree.
    repo = str(Path(args.repo).expanduser().resolve()) if args.repo else (None if args.no_worktree else detected)
    detected = None if repo else detected
    agent_block = block or state.get("main_block")
    if not agent_block:
        fail("no agent pane: pass --block or run `rexwork adopt` first")

    # The authorization: its hash and mode on disk, the token in a 0600 one-shot file
    # that the draft's Neovim reads and deletes. The token never travels in argv.
    token = secrets.token_urlsafe(24)
    record = {"token_sha256": token_hash(token), "created_at": int(time.time()), "dry_run": bool(args.dry_run),
              "repo": repo, "detected_repo": detected}
    token_file = directory / "promote.token"
    with session_lock(directory):
        (directory / "promote.json").write_text(json.dumps(record, indent=2) + "\n")
        token_file.unlink(missing_ok=True)
        fd = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(token)
    try:
        sock = prepare_viewer(draft.resolve(), session, agent_block)
        install_confirm_key(sock, {"draft": str(draft.resolve()), "token_file": str(token_file),
                                   "session": session, "rexwork": str(Path(__file__).resolve()),
                                   "dry_run": bool(args.dry_run), "python": sys.executable})
    except Failure:
        token_file.unlink(missing_ok=True)
        (directory / "promote.json").unlink(missing_ok=True)
        raise
    token_file.unlink(missing_ok=True)  # Neovim has read it; normally already gone

    docview_args = [sys.executable, str(DOCVIEW), "open", str(draft.resolve()), "--session", session,
                    "--agent-block", agent_block, "--title", "Ticket draft", "--tab-label", "Ticket: draft",
                    "--kind", "ticket"]
    if args.no_focus:
        docview_args.append("--no-focus")
    out = run(docview_args, timeout=60)
    if out.returncode != 0:
        fail(f"docview: {out.stderr.strip()}")
    view = json.loads(out.stdout)
    result = {"draft": str(draft), "viewer": view.get("viewer"), "confirm_key": True,
              "dry_run": bool(args.dry_run), "would_create": describe_input(payload, info),
              "repo": repo, "detected_repo": detected,
              "message": "The draft is open in Neovim. Tal files it with Space r L (or :RexworkFile) and "
                         "typing yes; closing the float files nothing."}
    if detected:
        result["branch_hint"] = branch_hint(detected)
        note(branch_hint(detected))
    if pending_note(state):
        result["pending"] = pending_note(state)
        note(result["pending"])
    emit(result)


def prepare_viewer(draft, session, agent_block):
    """Start the session's shared editor Neovim (docview's) if needed; its socket. The draft
    becomes a tab there when `docview open` shows it; its comments go to AGENT_BLOCK."""
    dv = importlib_docview()
    try:
        sock, _ = dv.ensure_server(session, cwd=draft.parent)
    except SystemExit:
        fail(f"could not start the editor Neovim for {draft}")
    return sock


def install_confirm_key(sock, params):
    """Load promote.lua into the draft's Neovim. Values travel as JSON data (docview's `arg`),
    never inside the Lua source. Fails, before any float opens, if it does not load."""
    dv = importlib_docview()
    code = ("(function() local ok, r = pcall(function() return dofile(_A.lua)(_A.params) end) "
            "if ok then return r end return 'error: ' .. tostring(r) end)()")
    result = None
    for _ in range(3):
        result = dv.lua(Path(sock), code, timeout=5, arg={"lua": str(PROMOTE_LUA), "params": params})
        if result == 1:
            return True
        if isinstance(result, str):
            break
        time.sleep(0.3)
    fail(f"could not install the confirm key in the draft's Neovim: {result!r}; no float opened")


_DOCVIEW = None


def importlib_docview():
    global _DOCVIEW
    if _DOCVIEW is None:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        loader = SourceFileLoader("docview", str(DOCVIEW))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader("docview", loader))
        loader.exec_module(module)
        _DOCVIEW = module
    return _DOCVIEW


def request_draft(session, directory, state):
    main = state.get("main_block")
    if not main:
        fail("no main pane recorded; run `rexwork adopt` from the agent pane")
    text = REQUEST_DRAFT.format(objectives=directory / "objectives.md", draft=directory / "ticket-draft.md")
    program = rexchat_program() if state.get("harness") == "rexchat" else None
    # rexchat takes a prompt over its socket (queued while a turn runs), whatever has focus in it.
    try:
        said = bool(program) and run([program, "--block", main, f"--say={text}"], timeout=30).returncode == 0
    except Failure:
        said = False
    if not said:
        if program:
            note("rexchat did not take the request; typing it into the pane instead")
        rex("send", "-s", session, "-b", main, text)
        rex("send-key", "-s", session, "-b", main, "enter")
    emit({"requested": True, "agent_block": main,
          "message": "No draft yet; asked the agent to write one and run `rexwork promote`."})


def read_json_stdin():
    try:
        data = json.loads(sys.stdin.read())
    except ValueError:
        fail("expected a JSON object on stdin")
    if not isinstance(data, dict):
        fail("expected a JSON object on stdin")
    return data


def preview_request(directory):
    """`--preview`: parse the content on stdin (what the float is about to confirm) and
    report what would be filed. No network, no authorization, nothing written."""
    req = read_json_stdin()
    content = req.get("content")
    if not isinstance(content, str):
        fail("no content on stdin")
    try:
        title, description = parse_draft(content)
    except ValueError as e:
        fail(str(e))
    try:
        record = json.loads((directory / "promote.json").read_text())
    except (OSError, ValueError):
        record = {}
    out = {**preview_of(title, description, record), "digest": content_digest(content),
           "dry_run": bool(record.get("dry_run"))}
    pending = pending_note(read_state(directory))
    if pending:
        out["pending"] = pending
    emit(out)


def load_authorization(directory):
    try:
        record = json.loads((directory / "promote.json").read_text())
    except (OSError, ValueError):
        fail("no open authorization for this session (already used, or never opened); "
             "run `rexwork promote` again")
    if not isinstance(record, dict):
        fail("promote.json is not a JSON object; run `rexwork promote` again")
    return record


def filing_request(args, directory, draft, pending=None):
    """What to file and whether Tal confirmed it: (content, digest, record).

    From the float (--stdin): the request carries the token, the exact content Tal
    confirmed and its digest. The content must match the digest, the token must match
    the open authorization, and the mode (real or dry run) must match the one recorded.
    The draft file on disk is never read. From a terminal: the file is read once, shown,
    and that same text is filed after Tal types yes."""
    if args.stdin:
        req = read_json_stdin()
        record = load_authorization(directory)
        token, content, digest = req.get("token"), req.get("content"), req.get("digest")
        if not (isinstance(token, str) and isinstance(content, str) and isinstance(digest, str)):
            fail("the request needs token, content and digest")
        if not secrets.compare_digest(record.get("token_sha256", ""), token_hash(token)):
            fail("the confirm token does not match the open authorization; run `rexwork promote` again")
        if time.time() - int(record.get("created_at", 0)) > AUTH_TTL:
            fail("the authorization has expired; run `rexwork promote` again")
        mode = bool(req.get("dry_run"))
        if mode != bool(record.get("dry_run")) or mode != bool(args.dry_run):
            fail(f"mode mismatch: the authorization is for {'a dry run' if record.get('dry_run') else 'real filing'}")
        if not secrets.compare_digest(content_digest(content), digest):
            fail("the content does not match the digest Tal confirmed; nothing filed")
        return content, digest, record
    if sys.stdin.isatty() and sys.stderr.isatty():
        if args.draft:
            draft = Path(args.draft).expanduser().resolve()
        if not draft.exists():
            fail(f"no draft at {draft}")
        content = draft.read_text()
        try:
            title, description = parse_draft(content)
        except ValueError as e:
            fail(f"{draft}: {e}")
        record = {"dry_run": bool(args.dry_run),
                  "repo": str(Path(args.repo).expanduser().resolve()) if args.repo else None}
        ask = (f"Note: {pending}\nReconcile that attempt (nothing new is created)? Type yes: " if pending
               else f"Create this issue in {TEAM}, assigned to you, In Progress? Type yes: ")
        sys.stderr.write(("DRY RUN (nothing is written)\n" if args.dry_run else "")
                         + f"Title: {title}\n\n{description}\n" + ask)
        sys.stderr.flush()
        if sys.stdin.readline().strip() != "yes":
            fail("not filed")
        return content, content_digest(content), record
    fail("refusing to file without Tal's confirmation: Tal files from the draft float "
         "(Space r L) or runs `rexwork promote --file` in a terminal")


def file_ticket(args, session, directory, draft):
    """The one place an issue is created. Under the session lock, in order: refuse a
    finished promotion; check the request (token, digest and mode, or Tal's yes in a
    terminal) before anything else; a dry run then reports and writes nothing (it only
    uses up the authorization). A real, confirmed attempt with an earlier unfinished one
    reconciles that by its recorded issue id and creates nothing. Otherwise: use up the
    authorization, record the attempt (with the issue id chosen here, so Linear can not
    create it twice), issueCreate, then the post-filing steps."""
    with session_lock(directory):
        state = read_state(directory)
        if state.get("kind") == "ticketed" and not pending_steps(state):
            fail(f"this session is already ticketed ({state.get('ticket')})")
        earlier = state.get("filing") if isinstance(state.get("filing"), dict) else None
        earlier = earlier if earlier and not earlier.get("dry_run") else None
        content, digest, record = filing_request(args, directory, draft,
                                                 pending=pending_note(state) if earlier else None)
        if not args.stdin and not record.get("repo") and not args.no_worktree:
            record["repo"] = detect_repo(session, state)  # default on, as `rexwork promote` does
        try:
            title, description = parse_draft(content)
        except ValueError as e:
            fail(str(e))
        dry_run = bool(record.get("dry_run"))
        if dry_run:
            payload, info = build_issue_input(title, description)  # read-only lookups
            if args.stdin:
                (directory / "promote.json").unlink(missing_ok=True)  # one use only
            payload["id"] = "<chosen when filing>"
            tree = plan_worktree(record["repo"], f"{TEAM}-0", title) if record.get("repo") else None
            if tree:
                tree["worktree_provider"] = worktree_provider(tree["repo"])
                if tree["worktree_provider"] == "treehouse":
                    tree["worktree"] = f"a treehouse slot leased by {lease_holder(TEAM + '-<n>')}"
            out = {"dry_run": True, "digest": digest, "would_create": describe_input(payload, info),
                   "preview": preview_of(title, description, record),
                   "then": {"session_label": ticket_label(f"{TEAM}-<n>", title), "tab_label": f"{TEAM}-<n>",
                            "state": {"kind": "ticketed"},
                            "worktree": tree and {**tree, "note": "branch uses the real ticket number"}}}
            if earlier:
                out["pending"] = pending_note(state)
                out["would_create"] = None
            emit(out)
            return
        if earlier:
            # Confirmed for real: finish the earlier attempt; never create a second issue.
            reconcile_filing(session, directory, state, earlier)
            if args.stdin:
                (directory / "promote.json").unlink(missing_ok=True)
            return
        payload, info = build_issue_input(title, description)
        if args.stdin:
            (directory / "promote.json").unlink(missing_ok=True)  # one use only
        filing = {"at": int(time.time()), "title": title, "digest": digest, "issue_uuid": str(uuid.uuid4()),
                  "dry_run": False, "repo": record.get("repo"), "detected_repo": record.get("detected_repo")}
        payload["id"] = filing["issue_uuid"]
        update_state(directory, filing=filing)
        (directory / "ticket-filed.md").write_text(content)
        try:
            issue = create_issue(payload)
        except Failure as e:
            fail(f"{e}. The filing record stays in session.json, so this can not file twice: run "
                 "`rexwork promote --recover` in a terminal to look the issue up in Linear by its id and adopt it")
        record_ticket(directory, filing, issue)
        finish_promote(session, directory, issue)


def record_ticket(directory, filing, issue):
    """The issue exists: the session is ticketed from here on, whatever happens next.
    `filing.done` lists the post-filing steps finished so far."""
    update_state(directory, filing={**filing, "issue_id": issue["id"], "ticket": issue["identifier"], "done": []},
                 kind="ticketed", ticket=issue["identifier"], title=issue["title"], url=issue["url"], drafting=None)


def reconcile_filing(session, directory, state, filing, adopted=True):
    """Finish an earlier real attempt without creating anything: adopt the issue Linear has
    under the attempt's recorded id, or finish the steps for the recorded ticket."""
    if filing.get("ticket"):
        issue = get_issue(filing.get("issue_id") or filing["ticket"])
        if state.get("kind") != "ticketed" or "done" not in filing:
            # Recorded by an older rexwork that stopped before relabelling.
            update_state(directory, filing={**filing, "done": filing.get("done", [])}, kind="ticketed",
                         ticket=issue["identifier"], title=issue["title"], url=issue["url"], drafting=None)
    else:
        issue = find_filed_issue(filing)
        if not issue:
            fail(no_issue_message(session, filing))
        note(f"an earlier filing attempt created {issue['identifier']}; adopting it")
        record_ticket(directory, filing, issue)
    return finish_promote(session, directory, issue, adopted=adopted)


def no_issue_message(session, filing):
    return (f"Linear has no issue with id {filing.get('issue_uuid')}, the id the earlier filing attempt "
            f"({describe_when(filing)}, title {filing.get('title')!r}) sent, so that attempt filed nothing. "
            "Nothing was filed now. To retry: run `rexwork promote --clear-filing "
            f"--session {session}` in a terminal (type yes), then `rexwork promote` and confirm again")


def recover_promotion(args, session, directory):
    """`promote --recover`: the explicit way to finish an earlier real attempt. Read-only
    lookups first; then, after Tal types yes in a terminal, adopt and finish. Creates
    nothing in Linear. With --dry-run it reports and writes nothing."""
    with session_lock(directory):
        state = read_state(directory)
        filing = state.get("filing") if isinstance(state.get("filing"), dict) else None
        steps = pending_steps(state)
        if not filing or filing.get("dry_run") or (filing.get("ticket") and not steps):
            fail("nothing to recover: no interrupted filing or unfinished promotion in session.json")
        if filing.get("ticket"):
            issue = get_issue(filing.get("issue_id") or filing["ticket"])
            what = f"finish promoting {issue['identifier']}: {', '.join(steps)}"
        else:
            issue = find_filed_issue(filing)
            if not issue:
                fail(no_issue_message(session, filing))
            what = (f"adopt {issue['identifier']} ({issue['title']!r}, issue id {issue['id']}, created by the "
                    f"attempt at {describe_when(filing)}), then: {', '.join(post_filing_steps(filing))}")
        if args.dry_run:
            emit({"dry_run": True, "recover": what, "ticket": issue["identifier"], "url": issue.get("url")})
            return
        if not (sys.stdin.isatty() and sys.stderr.isatty()):
            fail(f"--recover asks for confirmation; run it in a terminal. It would {what}")
        sys.stderr.write(f"Recover: {what}. Nothing is created in Linear. Type yes: ")
        sys.stderr.flush()
        if sys.stdin.readline().strip() != "yes":
            fail("not recovered")
        return reconcile_filing(session, directory, state, filing)


def clear_filing(directory):
    with session_lock(directory):
        state = read_state(directory)
        filing = interrupted_filing(state)
        if not filing:
            fail("no interrupted filing to clear")
        if filing.get("issue_uuid"):
            issue = find_filed_issue(filing)
            if issue:
                fail(f"Linear has {issue['identifier']} from that attempt; run `rexwork promote --recover` "
                     "in a terminal to adopt it")
            known = f"Linear has no issue with its id {filing['issue_uuid']}."
        else:
            known = "It recorded no issue id; check Linear by hand first."
        if not (sys.stdin.isatty() and sys.stderr.isatty()):
            fail("--clear-filing asks for confirmation; run it in a terminal")
        sys.stderr.write(f"Clear the interrupted filing of {filing.get('title')!r}? {known} Type yes: ")
        sys.stderr.flush()
        if sys.stdin.readline().strip() != "yes":
            fail("not cleared")
        update_state(directory, filing=None)
    emit({"cleared": True})


def finish_promote(session, directory, issue, adopted=False):
    """The post-filing steps still pending for the recorded ticket, each recorded in
    `filing.done` as it completes, so a retry does only what is left. Creates nothing in
    Linear."""
    ticket, title = issue["identifier"], issue["title"]
    label = ticket_label(ticket, title)
    errors, notes = [], []
    state = read_state(directory)
    filing = dict(state["filing"])
    done = list(filing.get("done", []))

    def mark(step, **updates):
        nonlocal filing
        done.append(step)
        filing = {**filing, "done": list(done)}
        update_state(directory, filing=filing, **updates)

    if "label" not in done:
        try:
            rex("session", "rename", session, label)
            if state.get("window_id"):
                rex("window", "rename", "-s", session, state["window_id"], ticket)
            mark("label", label=label)
        except Failure as e:
            errors.append(str(e))
    repo = filing.get("repo")
    if repo and "worktree" not in done:
        try:
            tree = ensure_worktree(repo, ticket, title, read_state(directory))
            mark("worktree", **tree_fields(tree))
            if tree.get("worktree_created"):
                hand_over_worktree(directory, tree["worktree"])
        except WorktreeIncomplete as e:
            update_state(directory, **tree_fields(e.tree))  # keep the lease so a retry reuses it
            errors.append(str(e))
        except Failure as e:
            errors.append(str(e))
    elif not repo and filing.get("detected_repo"):
        notes.append(branch_hint(filing["detected_repo"]).replace("No branch will be attached", "No branch attached")
                     .replace("tal-<n>", ticket.lower()))
        if not state.get("repo"):
            update_state(directory, repo=filing["detected_repo"])
    pending = [s for s in post_filing_steps(filing) if s not in done]
    if not pending:
        update_state(directory, promoted_at=int(time.time()))
    state = read_state(directory)
    (directory / "promote.json").unlink(missing_ok=True)
    for n in notes:
        note(n)
    emit({"ticket": ticket, "url": issue["url"], "label": state.get("label"), "worktree": state.get("worktree"),
          "branch": state.get("branch"), "repo": state.get("repo"), "adopted": adopted, "notes": notes,
          "errors": errors, "pending": pending})
    if pending:
        fail(f"{ticket} is filed, but {', '.join(pending)} did not finish: {'; '.join(errors)}. Fix that, then "
             "run `rexwork promote --recover` in a terminal; it finishes only what is left and creates nothing")


