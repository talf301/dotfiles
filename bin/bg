#!/usr/bin/env python3
"""bg: the single launch path for a background bead session (one attempt).

  bg <bead> --done-when CMD [--name "<bead>: <2-4 words>"] [--auto]
  bg <bead> --cwd SLOT --prompt TEXT [--name ...]  session in a Precog slot the caller leases
  bg --new TITLE (--done-when CMD | --cwd SLOT --prompt TEXT) [--name ...]
  bg --self-test

--new is for non-bead work: it creates a task bead (label adhoc) first, then runs as above.
With --cwd there is no new lease and no brief: SLOT must be a leased treehouse slot of REPO
(bin/bg stays Precog-only). The session starts in SLOT with TEXT (plus its bead id) as its
prompt, and the attempt comment has `brief: none`.

Steps, in order. If a step fails, bg undoes the earlier steps in reverse order and
writes the bead comment `attempt-failed: <step> attempt=<n> <error>`:
  lease    treehouse get --lease, holder agent:<bead>#<n>     undo: return each slot that holder has
  claim    status in_progress, assignee agent:<bead>#<n>      undo: status open, assignee cleared
  brief    render iar/WORKFLOW.md to $LOG_DIR/dispatch-<bead>-<n>.md   undo: delete it
  start    claude --bg --settings iar/dispatch-settings.json  undo: stop sessions in the slot
  comment  attempt: <n> session: <sid> slot: <path> branch: <ref> brief: <path>[ dispatch: auto]
           (--auto: started by the reconciler, W14; it stops the session if the bead loses the label)
The comment is last because `claude --bg` ignores --session-id: the session id exists only
after start (spec order lease, claim, comment, brief, start; see decision comment on precog-lxt4).

Env: BEADS_DIR (default: Precog store), REPO (default ~/Documents/precog), LOG_DIR (default
~/.local/state/iar). BG_FAULT_AFTER=<step> injects a failure after that step (tests only).
Prints one JSON line on success.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

IAR = Path(__file__).resolve().parent.parent / "iar"
sys.path.insert(0, str(IAR))
import ledger  # noqa: E402
import workflow  # noqa: E402

os.environ.setdefault("BEADS_DIR", "/Users/tal/.local/share/beads/precog/.beads")
REPO = os.environ.get("REPO", os.path.expanduser("~/Documents/precog"))
LOG_DIR = Path(os.environ.get("LOG_DIR", os.path.expanduser("~/.local/state/iar")))
SETTINGS = IAR / "dispatch-settings.json"
LEASE_TIMEOUT_S = 900  # a lease fetches origin; about 4 min on Precog
AGENTS_WAIT_S = 30
ATTEMPT_RE = re.compile(r"attempt(?:: |-failed: \S+ attempt=)(\d+)\b")


class StepError(RuntimeError):
    pass


def sh(cmd, cwd=None, timeout=120):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError) as e:
        raise StepError(f"{cmd[0]} {cmd[1]}: {e}")
    if p.returncode != 0:
        raise StepError(f"{cmd[0]} {cmd[1]} exit {p.returncode}: {(p.stderr or p.stdout).strip()[-300:]}")
    return p.stdout


def next_attempt(issue):
    nums = [int(m.group(1)) for c in issue.get("comments") or []
            if (m := ATTEMPT_RE.match(c.get("text", "")))]
    return max(nums, default=0) + 1


def held_by(holder):
    """Slots leased to holder. Reads `status --json` by key: same on treehouse v2 and v3."""
    return [s for s in json.loads(sh(["treehouse", "status", "--json"], cwd=REPO))
            if s.get("lease_holder") == holder]


def base_and_branch(issue, slot):
    def ref(name):
        try:
            return sh(["git", "-C", slot, "rev-parse", "--verify", "--quiet", name]).strip()
        except StepError:
            return ""
    branch = f"u/tfriedman/iar-{issue['id']}"
    slugs = [x[3:] for x in issue.get("labels") or [] if x.startswith("pr:")]
    base = (slugs and ref(f"origin/u/tfriedman/pr/{slugs[0]}")) or ref("origin/main")
    if not base:
        raise StepError("no base: origin/main not found in slot")
    action = f"resume origin/{branch}" if ref(f"origin/{branch}") else f"create it at {base}"
    pr_group = f"u/tfriedman/pr/{slugs[0]}" if slugs else "none"
    return base, branch, action, pr_group


def render(values):
    try:
        return workflow.render(values)
    except workflow.WorkflowError as e:
        raise StepError(str(e))


def write_brief(bead, issue, name, n, a, done_when, undo):
    """Render the brief for a leased slot; returns the session prompt."""
    base, a["branch"], action, pr_group = base_and_branch(issue, a["slot"])
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    brief, base_file = LOG_DIR / f"dispatch-{bead}-{n}.md", LOG_DIR / f"base-{bead}"
    a["brief"] = str(brief)
    old_base = base_file.read_text() if base_file.exists() else None

    def unbrief():
        brief.unlink(missing_ok=True)
        if old_base is None:
            base_file.unlink(missing_ok=True)
        else:
            base_file.write_text(old_base)
    undo.append(("brief", unbrief))
    brief.write_text(render({"bead": bead, "title": issue["title"], "name": name, "attempt": n,
                             "slot": a["slot"], "base_sha": base, "branch": a["branch"],
                             "branch_action": action, "pr_group": pr_group,
                             "done_when": done_when}))
    base_file.write_text(base + "\n")
    return f"Read and follow {brief}"


def new_bead(title, prompt=None):
    """Non-bead work gets a bead first, so bin/bg and the reconciler can track it."""
    return ledger.create(title, type="task", labels=["adhoc"], description=prompt or title)["id"]


def dispatch(bead, done_when, name=None, cwd=None, prompt=None, auto=False):
    issue = ledger.show(bead)
    if "quarantined" in (issue.get("labels") or []):  # reconcile.py over-limit; Tal removes the label
        print(f"bg: {bead} is quarantined (attempt limit): not dispatchable", file=sys.stderr)
        return 1
    if issue["status"] != "open" or issue.get("assignee"):
        print(f"bg: {bead} is {issue['status']}, assignee {issue.get('assignee')}: not dispatchable",
              file=sys.stderr)
        return 1
    n = next_attempt(issue)
    holder = f"agent:{bead}#{n}"
    name = name or f"{bead}: {issue['title'][:40]}"
    fault = os.environ.get("BG_FAULT_AFTER")
    undo, a = [], {"attempt": n}  # undo: (label, fn) pairs, run in reverse
    step = "lease"
    try:
        if cwd:  # the caller leases this slot: no lease to take or undo
            a["slot"] = str(Path(cwd).resolve())
            leased = [s["path"] for s in json.loads(sh(["treehouse", "status", "--json"], cwd=REPO))
                      if s.get("lease_holder")]
            if a["slot"] not in {str(Path(p).resolve()) for p in leased}:
                raise StepError(f"--cwd {a['slot']} is not a leased treehouse slot of {REPO}")
        else:
            def unlease():  # finds the lease by holder, so it works when get's output is lost
                for s in held_by(holder):
                    sh(["treehouse", "return", s["path"], "--force", "--if-lease-id", s["lease_id"]], cwd=REPO)
                if held_by(holder):
                    raise StepError(f"lease {holder} still held after return")
            undo.append(("lease", unlease))
            out = sh(["treehouse", "get", "--lease", "--json", "--lease-holder", holder], cwd=REPO,
                     timeout=LEASE_TIMEOUT_S)
            a["slot"] = json.loads(out[out.index("{"):])["path"]
            if fault == step:
                raise StepError("injected fault")

        step = "claim"
        def unclaim():  # registered first: the update can land even when its answer is lost
            if ledger.show(bead).get("assignee") == holder:
                ledger.update(bead, status="open", assignee="")
            if ledger.show(bead).get("assignee") == holder:
                raise StepError(f"{bead} still claimed by {holder}")
        undo.append(("claim", unclaim))
        ledger.update(bead, status="in_progress", assignee=holder)
        if fault == step:
            raise StepError("injected fault")

        step = "brief"
        if prompt:
            prompt += f"\n\nYour bead: {bead} (Beads store {os.environ['BEADS_DIR']})."
            a["branch"] = sh(["git", "-C", a["slot"], "rev-parse", "--abbrev-ref", "HEAD"]).strip()
            a["brief"] = "none"
        else:
            prompt = write_brief(bead, issue, name, n, a, done_when, undo)
        if fault == step:
            raise StepError("injected fault")

        step = "start"

        def in_slot():  # our sessions (by name) in the slot that are not stopped
            return [s for s in json.loads(sh(["claude", "agents", "--json"]))
                    if os.path.realpath(s.get("cwd") or "/") == os.path.realpath(a["slot"])
                    and s.get("name") == name and s.get("state") != "stopped"]

        def unstart():  # by slot and name, not id, so it works when the id is lost
            for _ in range(AGENTS_WAIT_S):  # a new session can take a moment to be listed
                if in_slot():
                    break
                time.sleep(1)
            for s in in_slot():
                sh(["claude", "stop", s["id"]])
            if in_slot():
                raise StepError("session still running in slot after claude stop")
        undo.append(("start", unstart))
        out = sh(["claude", "--bg", "--settings", str(SETTINGS), "--name", name,
                  prompt], cwd=a["slot"])
        m = re.search(r"backgrounded\W+(\w+)", out)
        if not m:
            raise StepError(f"claude --bg printed no session id: {out.strip()[:200]}")
        short = m.group(1)
        a["session"] = ""
        for _ in range(AGENTS_WAIT_S):
            hit = [s for s in json.loads(sh(["claude", "agents", "--json"])) if s.get("id") == short]
            if hit:
                a["session"] = hit[0]["sessionId"]
                break
            time.sleep(1)
        if not a["session"]:
            raise StepError(f"session {short} not in claude agents after {AGENTS_WAIT_S}s")
        if fault == step:
            raise StepError("injected fault")

        step = "comment"
        ledger.comment(bead, f"attempt: {n} session: {a['session']} slot: {a['slot']} "
                             f"branch: {a['branch']} brief: {a['brief']}" + " dispatch: auto" * auto)
        if fault == step:
            raise StepError("injected fault")
    except (StepError, ledger.LedgerError, OSError, ValueError, KeyError) as e:
        errors = [f"{type(e).__name__}: {e}" if not isinstance(e, StepError) else str(e)]
        for label, fn in reversed(undo):
            try:
                fn()
            except (StepError, ledger.LedgerError, OSError, ValueError) as ue:
                errors.append(f"UNDO {label} FAILED: {ue}")
        text = f"attempt-failed: {step} attempt={n} " + "; ".join(errors)
        try:
            ledger.comment(bead, text)
        except ledger.LedgerError as ce:
            print(f"bg: could not write comment: {ce}", file=sys.stderr)
        print(f"bg: {text}", file=sys.stderr)
        return 1
    print(json.dumps({"bead": bead, "name": name, **a}))
    return 0


# ---------------------------------------------------------------- self-test

FAKE_TREEHOUSE = r'''#!/usr/bin/env python3
import json, os, subprocess, sys, uuid
st = os.path.join(os.environ["FAKE"], "leases.json")
leases = json.load(open(st)) if os.path.exists(st) else {}
a = sys.argv[1:]
def save(): json.dump(leases, open(st, "w"))
if a[0] == "get":
    slot = os.path.join(os.environ["FAKE"], "slot-%d" % len(os.listdir(os.environ["FAKE"])))
    subprocess.run(["git", "clone", "-q", os.environ["FAKE_ORIGIN"], slot], check=True)
    lid = uuid.uuid4().hex
    leases[slot] = {"lease_id": lid, "holder": a[a.index("--lease-holder") + 1]}
    save()
    if os.environ.get("FAKE_GET_GARBAGE"):
        sys.exit("lease made, then a crash")
    print(json.dumps({"path": slot, "lease_id": lid, "lease_holder": leases[slot]["holder"]}))
elif a[0] == "return":
    if os.environ.get("FAKE_RETURN_EXIT"):
        sys.exit(int(os.environ["FAKE_RETURN_EXIT"]))  # v3: exit 3 = not returned
    if leases.get(a[1], {}).get("lease_id") == a[a.index("--if-lease-id") + 1]:
        del leases[a[1]]
    save()
elif a[0] == "status":
    rows = [{"name": "9", "path": "/x/9", "status": "available", "lease_id": "", "lease_holder": ""}]
    for p, l in leases.items():
        rows.append({"name": p, "path": p, "status": "leased", "lease_id": l["lease_id"],
                     "lease_holder": l["holder"], "processes": []})
    if os.environ.get("FAKE_TH_V3"):
        for r in rows:
            r["branch"] = "main"
    print(json.dumps(rows))
'''

FAKE_CLAUDE = r'''#!/usr/bin/env python3
import json, os, sys, time, uuid
st = os.path.join(os.environ["FAKE"], "sessions.json")
ss = json.load(open(st)) if os.path.exists(st) else []
a = sys.argv[1:]
if "--bg" in a:
    sid = str(uuid.uuid4())
    ss.append({"id": sid[:8], "sessionId": sid, "kind": "background", "state": "working",
               "listed_at": time.time() + float(os.environ.get("FAKE_LIST_DELAY") or 0),
               "name": a[a.index("--name") + 1], "cwd": os.getcwd(), "argv": a})
    if os.environ.get("FAKE_BG_GARBAGE"):
        print("unexpected output")
        json.dump(ss, open(st, "w"))
        sys.exit(0)
    print("warning: --bg manages the session id; ignoring --session-id")
    print("backgrounded · %s · %s" % (sid[:8], ss[-1]["name"]))
elif a[:1] == ["agents"]:
    print(json.dumps([s for s in ss if s["listed_at"] <= time.time()]))  # real `claude agents --json` lists stopped sessions as state "stopped"
elif a[:1] == ["stop"]:
    for s in ss:
        if s["id"] == a[1]:
            s["state"] = "stopped"
json.dump(ss, open(st, "w"))
'''


def self_test():
    global REPO, LOG_DIR
    with tempfile.TemporaryDirectory() as root:
        r = Path(root)
        fake, binp, origin = r / "fake", r / "bin", r / "origin"
        for d in (fake, binp):
            d.mkdir()
        for exe, src in (("treehouse", FAKE_TREEHOUSE), ("claude", FAKE_CLAUDE)):
            (binp / exe).write_text(src)
            (binp / exe).chmod(0o755)
        sh(["git", "init", "-q", "-b", "main", str(origin)])
        sh(["git", "-C", str(origin), "-c", "user.email=t@t", "-c", "user.name=t",
            "commit", "-q", "--allow-empty", "-m", "init"])
        main_sha = sh(["git", "-C", str(origin), "rev-parse", "HEAD"]).strip()
        old = {k: os.environ.get(k) for k in ("BEADS_DIR", "PATH", "FAKE", "FAKE_ORIGIN",
                                              "BG_FAULT_AFTER", "FAKE_RETURN_EXIT", "FAKE_TH_V3",
                                              "FAKE_GET_GARBAGE", "FAKE_BG_GARBAGE", "FAKE_LIST_DELAY")}
        os.environ.update(BEADS_DIR=str(r / ".beads"), PATH=f"{binp}:{os.environ['PATH']}",
                          FAKE=str(fake), FAKE_ORIGIN=str(origin))
        REPO, LOG_DIR = str(r), r / "state"
        try:
            sh(["br", "init", "--prefix", "bg"], cwd=root)

            def leases():
                p = fake / "leases.json"
                return json.loads(p.read_text()) if p.exists() else {}

            def sessions():
                return [s for s in json.loads(sh(["claude", "agents", "--json"])) if s["state"] != "stopped"]

            def quiet(*args):  # dispatch() with its stdout and stderr lines hidden
                saved = sys.stdout, sys.stderr
                sys.stdout = sys.stderr = open(os.devnull, "w")
                try:
                    return dispatch(*args)
                finally:
                    sys.stdout.close()
                    sys.stdout, sys.stderr = saved

            # E7: a fault after each step leaves no claim, no lease and an attempt-failed comment.
            for i, step in enumerate(("lease", "claim", "brief", "start", "comment")):
                os.environ["FAKE_TH_V3"] = "1" if i % 2 else ""
                b = ledger.create(f"fault {step}", type="task")["id"]
                os.environ["BG_FAULT_AFTER"] = step
                if step == "start":  # an earlier base file is restored, not deleted
                    LOG_DIR.mkdir(exist_ok=True)
                    (LOG_DIR / f"base-{b}").write_text("old\n")
                assert quiet(b, "true") == 1, step
                s = ledger.show(b)
                assert s["status"] == "open" and not s.get("assignee"), (step, s)
                assert leases() == {} and sessions() == [], (step, leases(), sessions())
                texts = [c["text"] for c in s["comments"]]
                assert texts[-1].startswith(f"attempt-failed: {step} attempt=1 injected fault"), texts
                assert not (LOG_DIR / f"dispatch-{b}-1.md").exists(), step
                base_file = LOG_DIR / f"base-{b}"
                assert (base_file.read_text() == "old\n") if step == "start" else not base_file.exists()
            # The next attempt on the same bead is attempt 2.
            assert quiet(b, "true") == 1 and leases() == {}
            assert ledger.show(b)["comments"][-1]["text"].startswith("attempt-failed: comment attempt=2")

            # A step that fails half-way (lease made or session started, output lost) is undone too.
            os.environ["BG_FAULT_AFTER"] = ""
            # The started session is listed only after 2 s; undo waits for it before the lease goes.
            os.environ["FAKE_LIST_DELAY"] = "2"
            for step, var in (("lease", "FAKE_GET_GARBAGE"), ("start", "FAKE_BG_GARBAGE")):
                os.environ[var] = "1"
                b = ledger.create(f"half {step}", type="task")["id"]
                assert quiet(b, "true") == 1, step
                os.environ[var] = ""
                time.sleep(2)  # a session the undo missed would be listed by now
                s = ledger.show(b)
                assert s["status"] == "open" and not s.get("assignee"), (step, s)
                assert leases() == {} and sessions() == [], (step, leases(), sessions())
                assert s["comments"][-1]["text"].startswith(f"attempt-failed: {step} attempt=1"), s

            os.environ["FAKE_LIST_DELAY"] = ""
            # A claim that lands but whose answer is lost is undone.
            real_update = ledger.update

            def lossy_update(*args, **kw):
                real_update(*args, **kw)
                ledger.update = real_update
                raise ledger.LedgerError("br update: no answer in 30s")
            ledger.update = lossy_update
            b = ledger.create("claim lost", type="task")["id"]
            try:
                assert quiet(b, "true") == 1
            finally:
                ledger.update = real_update
            s = ledger.show(b)
            assert s["status"] == "open" and not s.get("assignee") and leases() == {}, s
            assert s["comments"][-1]["text"].startswith("attempt-failed: claim attempt=1"), s

            # A lease that treehouse does not return (v3 exit 3) is reported, not hidden.
            os.environ["BG_FAULT_AFTER"], os.environ["FAKE_RETURN_EXIT"] = "claim", "3"
            b = ledger.create("return fails", type="task")["id"]
            assert quiet(b, "true") == 1
            last = ledger.show(b)["comments"][-1]["text"]
            assert "UNDO lease FAILED" in last and ledger.show(b)["status"] == "open", last
            os.environ["FAKE_RETURN_EXIT"] = ""
            leases_left = leases()
            assert len(leases_left) == 1
            sh(["treehouse", "return", *leases_left, "--if-lease-id",
                next(iter(leases_left.values()))["lease_id"]])

            # Success: one attempt comment matching the claude agents session id.
            os.environ["BG_FAULT_AFTER"] = ""
            b = ledger.create("ok bead", type="task", labels=["pr:none-such"])["id"]
            assert quiet(b, "make test", f"{b}: ok bead") == 0
            s = ledger.show(b)
            att = [c["text"] for c in s["comments"] if c["text"].startswith("attempt")]
            (sess,) = sessions()
            (slot,) = leases()
            assert os.path.realpath(sess["cwd"]) == os.path.realpath(slot), (sess, slot)
            assert att == [f"attempt: 1 session: {sess['sessionId']} slot: {slot} "
                           f"branch: u/tfriedman/iar-{b} brief: {LOG_DIR}/dispatch-{b}-1.md"], att
            assert s["status"] == "in_progress" and s["assignee"] == f"agent:{b}#1", s
            (lease,) = leases().values()
            assert lease["holder"] == f"agent:{b}#1", lease
            argv = sess["argv"]
            assert argv[argv.index("--settings") + 1] == str(SETTINGS) and SETTINGS.exists(), argv
            brief = (LOG_DIR / f"dispatch-{b}-1.md").read_text()
            assert main_sha in brief and "make test" in brief and "Escalate only for" in brief
            assert "PR group: `u/tfriedman/pr/none-such`" in brief, brief
            assert (LOG_DIR / f"base-{b}").read_text().strip() == main_sha
            # A claimed bead is refused before any side effect.
            assert quiet(b, "true") == 1 and len(leases()) == 1

            # --cwd: a new adhoc bead runs in a slot the caller leases; no new lease, no brief.
            b = new_bead("adhoc ok", "do x")
            assert quiet(b, None, "a: no", str(r), "do x") == 1  # not a leased slot
            s = ledger.show(b)
            assert s["status"] == "open" and "not a leased treehouse slot" in s["comments"][-1]["text"], s
            out = sh(["treehouse", "get", "--lease", "--json", "--lease-holder", "agent:gnhf:t"])
            held = Path(json.loads(out)["path"])
            sh(["claude", "--bg", "--name", "other", "x"], cwd=held)  # not ours: undo leaves it
            os.environ["BG_FAULT_AFTER"] = "start"
            assert quiet(b, None, "a: fail", str(held), "do x") == 1
            assert [s["name"] for s in sessions() if s["cwd"] == str(held.resolve())] == ["other"]
            assert ledger.show(b)["status"] == "open" and len(leases()) == 2
            os.environ["BG_FAULT_AFTER"] = ""
            assert quiet(b, None, "a: ok", str(held), "do x", True) == 0
            s = ledger.show(b)
            assert s["labels"] == ["adhoc"] and s["description"] == "do x", s
            (sess,) = [x for x in sessions() if x["name"] == "a: ok"]
            assert sess["argv"][-1].startswith(f"do x\n\nYour bead: {b} ") and sess["cwd"] == str(held.resolve()), sess
            assert s["comments"][-1]["text"] == (f"attempt: 3 session: {sess['sessionId']} slot: "
                                                 f"{held.resolve()} branch: main brief: none dispatch: auto"), s
            assert s["assignee"] == f"agent:{b}#3" and len(leases()) == 2
        finally:
            for k, v in old.items():
                if v is None:
                    os.environ.pop(k, None)
                else:
                    os.environ[k] = v
    print("bg self-test: ok")


def main():
    p = argparse.ArgumentParser(prog="bg", description=__doc__.split("\n")[0])
    p.add_argument("bead", nargs="?")
    p.add_argument("--done-when")
    p.add_argument("--name")
    p.add_argument("--cwd")
    p.add_argument("--prompt")
    p.add_argument("--new", metavar="TITLE")
    p.add_argument("--auto", action="store_true")
    p.add_argument("--self-test", action="store_true")
    a = p.parse_args()
    if a.self_test:
        self_test()
        return 0
    if bool(a.bead) == bool(a.new):
        p.error("give a bead or --new TITLE")
    if bool(a.cwd) != bool(a.prompt) or bool(a.done_when) == bool(a.cwd):
        p.error("give --done-when, or --cwd and --prompt")
    try:
        bead = a.bead or new_bead(a.new, a.prompt)
        return dispatch(bead, a.done_when, a.name, a.cwd, a.prompt, a.auto)
    except ledger.LedgerError as e:  # the pre-check read failed: nothing was done
        print(f"bg: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
