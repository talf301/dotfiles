#!/usr/bin/env zsh

FONT_FACE="JetBrainsMono Nerd Font"
PLUGIN_SHARED_DIR="$HOME/.config/sketchybar/plugins"

if [[ -n "$SKETCHYBAR_LAPTOP" ]]; then
    BAR_DISPLAY="main"
    WORKSPACE_LABEL_PADDING=12
    WORKSPACE_ICON_PADDING=10
    WORKSPACE_LABEL_FONT_SIZE=16
    MAX_WORKSPACE_APPS=2
else
    BAR_DISPLAY="all"
    WORKSPACE_LABEL_PADDING=20
    WORKSPACE_ICON_PADDING=10
    WORKSPACE_LABEL_FONT_SIZE=16
    MAX_WORKSPACE_APPS=999
fi

sketchybar --bar \
    height=32 \
    color=0x66494d64 \
    margin=0 \
    sticky=on \
    padding_left=0 \
    padding_right=0 \
    notch_width=188 \
    display="$BAR_DISPLAY" \

sketchybar --default \
    background.height=32 \
    icon.color=0xff24273a \
    icon.font="$FONT_FACE:Medium:20.0" \
    icon.padding_left=5 \
    icon.padding_right=5 \
    label.color=0xff24273a \
    label.font="$FONT_FACE:Bold:14.0" \
    label.y_offset=1 \
    label.padding_left=0 \
    label.padding_right=5

sketchybar --add item claude_budget right \
    --set claude_budget \
    icon=:claude: \
    icon.font="sketchybar-app-font:Regular:18.0" \
    background.color=0xfff5a97f \
    update_freq=300 \
    script="$PLUGIN_SHARED_DIR/ai_budget.sh claude"

sketchybar --add item codex_budget right \
    --set codex_budget \
    icon=:codex: \
    icon.font="sketchybar-app-font:Regular:18.0" \
    background.color=0xfff5bde6 \
    update_freq=300 \
    script="$PLUGIN_SHARED_DIR/ai_budget.sh codex"

sketchybar --add item overseer_mail right \
    --set overseer_mail \
    icon= \
    icon.font="JetBrainsMono Nerd Font:Regular:15.0" \
    icon.color=0xfff38ba8 \
    drawing=off \
    update_freq=30 \
    script="$PLUGIN_SHARED_DIR/overseerMail.sh"


sketchybar --add item clock right \
    --set clock \
    icon=󰃰 \
    background.color=0xffc6a0f6 \
    update_freq=10 \
    script="$PLUGIN_SHARED_DIR/clock.sh"

sketchybar --add item battery right \
    --set battery \
    background.color=0xff8aadf4 \
    update_freq=60 \
    script="$PLUGIN_SHARED_DIR/battery.sh" \
    --subscribe battery power_source_change system_woke

sketchybar --add item volume right \
    --set volume \
    background.color=0xff8bd5ca \
    script="$PLUGIN_SHARED_DIR/volume.sh" \
    --subscribe volume volume_change mouse.scrolled

sketchybar --add item wifi right \
    --set wifi \
    background.color=0xffa6da95 \
    update_freq=15 \
    script="$PLUGIN_SHARED_DIR/wifi.sh" \
    --subscribe wifi wifi_change

sketchybar --add item calendar right \
    --set calendar \
    background.color=0xffed8796 \
    update_freq=60 \
    script="SKETCHYBAR_LAPTOP=${SKETCHYBAR_LAPTOP:-0} $PLUGIN_SHARED_DIR/calendar.sh" \
    --subscribe calendar mouse.clicked

sketchybar --add item display_watcher left \
    --set display_watcher \
    drawing=off \
    script="$PLUGIN_SHARED_DIR/display_change.sh ${SKETCHYBAR_LAPTOP:-0}" \
    --subscribe display_watcher display_change

if [[ -z "$SKETCHYBAR_LAPTOP" ]]; then
    sketchybar --add item ytmusic right \
        --set ytmusic \
        background.color=0xfff5a97f \
        icon.y_offset=1 \
        update_freq=5 \
        script="$PLUGIN_SHARED_DIR/ytmusic.sh" \
        --subscribe ytmusic mouse.clicked
fi

if [[ -z "$SKETCHYBAR_LAPTOP" ]]; then
    # Right-side items render in reverse of this internal order.
    sketchybar --reorder clock battery volume wifi codex_budget claude_budget ytmusic
else
    sketchybar --reorder clock battery volume wifi codex_budget claude_budget
fi


sketchybar --add event aerospace_workspace_change

