# Add workspaces for all monitors.
# aerospace's monitor-id does NOT match macOS arrangement order, but
# monitor-appkit-nsscreen-screens-id does — and sketchybar's display=N
# uses macOS arrangement order. So use nsscreen-id for display=,
# and monitor-id for querying workspaces.
while IFS='|' read -r monitor_id nsscreen_id; do
  for sid in $(aerospace list-workspaces --monitor "$monitor_id"); do
    sketchybar --add item space.$sid left \
      --set space.$sid display="$nsscreen_id" \
      --subscribe space.$sid aerospace_workspace_change \
      --set space.$sid \
      drawing=on \
      background.color=0xff363a4f \
      background.corner_radius=5 \
      background.drawing=on \
      background.border_color=0xffc6a0f6 \
      background.border_width=0 \
      background.height=25 \
      icon="$sid" \
      icon.color=0xffcad3f5 \
      icon.padding_left=$WORKSPACE_ICON_PADDING \
      icon.padding_right=5 \
      icon.shadow.distance=4 \
      icon.shadow.color=0xA0000000 \
      label.color=0xffcad3f5 \
      label.font="sketchybar-app-font:Regular:${WORKSPACE_LABEL_FONT_SIZE}.0" \
      label.padding_right=$WORKSPACE_LABEL_PADDING \
      label.padding_left=0 \
      label.y_offset=-1 \
      label.shadow.drawing=off \
      label.shadow.color=0xA0000000 \
      label.shadow.distance=4 \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_SHARED_DIR/aerospace.sh $sid"
  done
done < <(aerospace list-monitors --format "%{monitor-id}|%{monitor-appkit-nsscreen-screens-id}")

# Load Icons on startup for all monitors
for monitor_id in $(aerospace list-monitors --format "%{monitor-id}"); do
  for sid in $(aerospace list-workspaces --monitor "$monitor_id" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

    sketchybar --set space.$sid drawing=on

    icon_strip=""
    if [ "${apps}" != "" ]; then
      typeset -A seen_workspace_icons=()
      app_count=0
      while read -r app; do
        app_icon="$($HOME/.config/sketchybar/helpers/icon_map.sh "$app")"
        if [[ -n "${seen_workspace_icons[$app_icon]}" ]]; then
          continue
        fi
        seen_workspace_icons[$app_icon]=1
        if (( app_count < MAX_WORKSPACE_APPS )); then
          icon_strip+="$app_icon"
        fi
        (( app_count++ ))
      done <<<"${apps}"
      if (( app_count > MAX_WORKSPACE_APPS )); then
        icon_strip+="…"
      fi
    else
      icon_strip=""
    fi
    sketchybar --set space.$sid label="$icon_strip"
  done
done

##### Finalizing Setup #####
sketchybar --update
sketchybar --trigger space_change
